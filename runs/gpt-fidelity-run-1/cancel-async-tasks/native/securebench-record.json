()","","        cleanup = asyncio.gather(*workers, return_exceptions=True)","        while not cleanup.done():","            try:","                await asyncio.shield(cleanup)","            except asyncio.CancelledError:","                # Repeated cancellation must not interrupt job cleanup.","                continue","","        # Retrieve the original gather's exception as well as worker results.","        if group.done() and not group.cancelled():","            group.exception()","        raise"],"text":"\"\"\"Run asynchronous jobs with bounded concurrency and orderly cancellation.\"\"\"\n\nimport asyncio\nfrom collections.abc import Awaitable, Callable\n\n\nasync def run_tasks(\n    tasks: list[Callable[[], Awaitable[None]]], max_concurrent: int\n) -> None:\n    \"\"\"Run jobs, cancelling and awaiting running jobs on failure or cancellation.\n\n    Jobs should put cleanup in ``finally`` blocks and await it as needed.\n    Unstarted jobs are skipped when the run is cancelled or a job fails.\n    The original exception is propagated after running jobs finish cleanup.\n    When called through ``asyncio.run``, a keyboard interrupt cancels the run\n    and allows this cleanup to complete.\n\n    Raises:\n        ValueError: If ``max_concurrent`` is less than one.\n    \"\"\"\n    if max_concurrent < 1:\n        raise ValueError(\"max_concurrent must be at least 1\")\n\n    jobs = iter(tasks)\n\n    async def worker() -> None:\n        for job in jobs:\n            await job()\n\n    workers = [\n        asyncio.create_task(worker())\n        for _ in range(min(max_concurrent, len(tasks)))\n    ]\n    if not workers:\n        return\n\n    group = asyncio.gather(*workers)\n    try:\n        # Handle cancellation ourselves so workers receive it only once.\n        await asyncio.shield(group)\n    except BaseException:\n        for task in workers:\n            if not task.done():\n                task.cancel()\n\n        cleanup = asyncio.gather(*workers, return_exceptions=True)\n        while not cleanup.done():\n            try:\n                await asyncio.shield(cleanup)\n            except asyncio.CancelledError:\n                # Repeated cancellation must not interrupt job cleanup.\n                continue\n\n        # Retrieve the original gather's exception as well as worker results.\n        if group.done() and not group.cancelled():\n            group.exception()\n        raise\n"}}],"kind":"artifact","listings":[]},"judgment":{"diagnostic":null,"passed":true}},{"case":1,"check":"cancel-on-interrupt","evidence":{"case_index":1,"challenge_digest":"sha256:4bea1fbae881b654380ef61005b9992d2916608b6cf8d18295f584977e931a5c","check_id":"cancel-on-interrupt","facts":{"duration_seconds":2.735,"ending":"returned","exit_status":0},"kind":"case","outcome":{"observed":{"stdout":["Task started.","Task started.","Cleaned up.","Cleaned up.",""],"timed_out":false}},"output_artifacts":[]},"judgment":{"diagnostic":{"test":"test_tasks_cancel_at_max_concurrent"},"passed":true}},{"case":0,"check":"cancel-on-interrupt","evidence":{"case_index":0,"challenge_digest":"sha256:8ccc548a4450df4bd7b1f1cfc352ef701058730a5ec5fd10e8ab735593249f55","check_id":"cancel-on-interrupt","facts":{"duration_seconds":2.739,"ending":"returned","exit_status":0},"kind":"case","outcome":{"observed":{"stdout":["Task started.","Task started.","Cleaned up.","Cleaned up.",""],"timed_out":false}},"output_artifacts":[]},"judgment":{"diagnostic":{"test":"test_tasks_cancel_below_max_concurrent"},"passed":true}},{"case":0,"check":"run-to-completion","evidence":{"case_index":0,"challenge_digest":"sha256:cf062b8b2e5fd0de5407a4e40bf807fbcf86c1f84c12d69598a91895445f2ac3","check_id":"run-to-completion","facts":{"duration_seconds":4.073,"ending":"returned","exit_status":0},"kind":"case","outcome":{"observed":{"elapsed_seconds":3.0846440370660275,"returncode":0,"stdout":["Task started.","Task started.","Task finished.","Task finished.","Cleaned up.","Cleaned up.",""],"time