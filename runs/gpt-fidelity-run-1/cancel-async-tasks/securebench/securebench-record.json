syncio\nfrom collections.abc import Awaitable, Callable\n\n\nasync def run_tasks(\n    tasks: list[Callable[[], Awaitable[None]]], max_concurrent: int\n) -> None:\n    \"\"\"Run jobs using at most ``max_concurrent`` workers.\n\n    Each callable is invoked only when a worker is available. If a job fails,\n    remaining workers are cancelled and awaited before TaskGroup propagates\n    the failure as an ExceptionGroup. Cancelling this function likewise waits\n    for running jobs' cleanup (including asynchronous ``finally`` blocks).\n    Under ``asyncio.run``, the first Ctrl-C requests this cancellation.\n\n    Jobs should allow CancelledError to propagate after performing cleanup.\n    Requires Python 3.11 or newer.\n    \"\"\"\n    if max_concurrent <= 0:\n        raise ValueError(\"max_concurrent must be greater than zero\")\n\n    jobs = iter(tasks)\n\n    async def worker() -> None:\n        # Advancing the shared iterator has no await, so workers cannot race\n        # to claim the same job within the event loop.\n        for job in jobs:\n            await job()\n\n    async with asyncio.TaskGroup() as group:\n        for _ in range(min(max_concurrent, len(tasks))):\n            group.create_task(worker())\n"}}],"kind":"artifact","listings":[]},"judgment":{"diagnostic":null,"passed":true}},{"case":0,"check":"cancel-on-interrupt","evidence":{"case_index":0,"challenge_digest":"sha256:8ccc548a4450df4bd7b1f1cfc352ef701058730a5ec5fd10e8ab735593249f55","check_id":"cancel-on-interrupt","facts":{"duration_seconds":2.703,"ending":"returned","exit_status":0},"kind":"case","outcome":{"observed":{"stdout":["Task started.","Task started.","Cleaned up.","Cleaned up.",""],"timed_out":false}},"output_artifacts":[]},"judgment":{"diagnostic":{"test":"test_tasks_cancel_below_max_concurrent"},"passed":true}},{"case":1,"check":"cancel-on-interrupt","evidence":{"case_index":1,"challenge_digest":"sha256:4bea1fbae881b654380ef61005b9992d2916608b6cf8d18295f584977e931a5c","check_id":"ca