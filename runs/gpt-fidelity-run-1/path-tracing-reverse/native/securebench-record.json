..\\n\");"," V *im=malloc(800*600*sizeof(V)),l=norm((V){1,1,-1});"," for(int y=0;y<600;y++){"," fprintf(stderr,\"\\rProgress: %.1f%%\",(double)(100.f*y/600.f));"," float v=(float)y/599,yy=1-v;"," for(int x=0;x<800;x++){"," float u=(float)x/799;"," V d={u*(8.f/3.f)+0.f*yy-4.f/3.f,0.f*u+2.f*yy-1,0.f*u+0.f*yy-1};"," im[y*800+x]=trace(norm(d),l);"," }}"," fprintf(stderr,\"\\nRendering complete\\n\");FILE *f=fopen(\"image.ppm\",\"w\");"," if(f){fprintf(f,\"P3\\n800 600\\n255\\n\");for(int i=0;i<800*600;i++){"," V c=im[i];int r=(float)fmin(1,fmax(0,c.x))*255.99f,g=(float)fmin(1,fmax(0,c.y))*255.99f,b=(float)fmin(1,fmax(0,c.z))*255.99f;"," fprintf(f,\"%d %d %d\\n\",r,g,b);"," }fclose(f);fprintf(stderr,\"Wrote image to image.ppm\\n\");}"," else fprintf(stderr,\"Error: Could not open file image.ppm for writing\\n\");"," free(im);fprintf(stderr,\"Done.\\n\");return 0;","}"],"text":"#include <stdio.h>\n#include <stdlib.h>\n#include <math.h>\ntypedef struct{float x,y,z;} V;\ntypedef struct{float t;V p,n;int hit;} H;\nV add(V a,V b){return (V){a.x+b.x,a.y+b.y,a.z+b.z};}\nV sub(V a,V b){return (V){a.x-b.x,a.y-b.y,a.z-b.z};}\nV mul(V a,float b){return (V){a.x*b,a.y*b,a.z*b};}\nfloat dot(V a,V b){return (a.x*b.x+a.y*b.y)+a.z*b.z;}\nV norm(V a){float d=sqrtf(dot(a,a));return (V){a.x/d,a.y/d,a.z/d};}\nH sphere(V o,V d){\n V c={0,-.5f,-5},q=sub(o,c);float a=dot(d,d),b=2*dot(q,d),cc=(q.y*q.y+q.x*q.x)+q.z*q.z-1,disc=b*b-4*a*cc;\n H h={0};if(disc<0)return h;\n float t=(-b-sqrt((double)disc))/(2*a);\n if(t<.001f){t=(-b+sqrt((double)disc))/(2*a);if(t<.001f)return h;}\n h.t=t;h.p=add(o,mul(d,t));h.n=norm(sub(h.p,c));h.hit=1;return h;\n}\nV trace(V d,V l){\n H h=sphere((V){0,0,0},d);float t=-1.5f/d.y;V p,n;int ball=h.hit;\n if(fabsf(d.y)>=.0001f && t>=.001f && (!ball||t<=h.t)){ball=0;p=add((V){0,0,0},mul(d,t));n=(V){0,1,0};}\n else if(ball){p=h.p;n=h.n;}\n else{float t=.5f*(d.y+1),s=1-t;return (V){s+.5f*t,s+.7f*t,s+t};}\n H shadow=sphere(add(p,mul(n,.001f)),norm(l));\n float light=shadow.hit?.2f:.2f+.8f*(float)fmax(0,dot(n,l));\n if(ball)return (V){light,.2f*light,.2f*light};\n float c=((int)(floor(p.x)+floor(p.z))&1)?.4f:.9f;return mul((V){c,c,c},light);\n}\nint main(void){\n fprintf(stderr,\"Creating high-resolution image: 800x600\\nThis will be downsampled with ffmpeg after rendering\\nRendering high-resolution image...\\n\");\n V *im=malloc(800*600*sizeof(V)),l=norm((V){1,1,-1});\n for(int y=0;y<600;y++){\n fprintf(stderr,\"\\rProgress: %.1f%%\",(double)(100.f*y/600.f));\n float v=(float)y/599,yy=1-v;\n for(int x=0;x<800;x++){\n float u=(float)x/799;\n V d={u*(8.f/3.f)+0.f*yy-4.f/3.f,0.f*u+2.f*yy-1,0.f*u+0.f*yy-1};\n im[y*800+x]=trace(norm(d),l);\n }}\n fprintf(stderr,\"\\nRendering complete\\n\");FILE *f=fopen(\"image.ppm\",\"w\");\n if(f){fprintf(f,\"P3\\n800 600\\n255\\n\");for(int i=0;i<800*600;i++){\n V c=im[i];int r=(float)fmin(1,fmax(0,c.x))*255.99f,g=(float)fmin(1,fmax(0,c.y))*255.99f,b=(float)fmin(1,fmax(0,c.z))*255.99f;\n fprintf(f,\"%d %d %d\\n\",r,g,b);\n }fclose(f);fprintf(stderr,\"Wrote image to image.ppm\\n\");}\n else fprintf(stderr,\"Error: Could not open file image.ppm for writing\\n\");\n free(im);fprintf(stderr,\"Done.\\n\");return 0;\n}\n"}}],"kind":"artifact","listings":[]},"judgment":{"diagnostic":{"compressed":1112},"passed":true}},{"case":null,"check":"original","evidence":{"check_id":"original","files":[{"path":"/app/mystery","reason":"text is not valid UTF-8 at byte 24","sha256":"sha256:869eebc7779f565fafcaae5c4c366c8d86bd5d21d9a8d1389d34fc67c09911de","size":790376,"status":"unparsable","value":null}],"kind":"artifact","listings":[]},"judgment":{"diagnostic":null,"passed":true}},{"case":0,"check":"render","evidence":{"case_index":0,"challenge_digest":"sha256:ca3d163bab055381827226140568f3bef7eaac187cebd76878e0b63e9e442356","check_id":"render","facts":{"duration_seconds":1.367,"ending":"returned","exit_status":0},"kind":"case","outcome":{"observed":{"compile":{"ending":"exited","exit_status":0,"stderr_tail":""},"image":{"h