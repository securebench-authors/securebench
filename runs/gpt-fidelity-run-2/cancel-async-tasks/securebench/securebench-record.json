nup.\"\"\"\n\nimport asyncio\nfrom collections.abc import Awaitable, Callable\n\n\nasync def run_tasks(\n    tasks: list[Callable[[], Awaitable[None]]], max_concurrent: int\n) -> None:\n    \"\"\"Run each job once, with at most ``max_concurrent`` jobs active.\n\n    ``max_concurrent`` must be positive. On cancellation (including the first\n    Ctrl-C when using ``asyncio.run``), running jobs are cancelled and awaited\n    so their ``finally`` blocks can finish, including asynchronous cleanup.\n    Jobs that have not started are left uncalled.\n\n    If a job raises an exception, the other running jobs are cancelled and\n    awaited, and ``asyncio.TaskGroup`` propagates an exception group. Jobs\n    must cooperate with cancellation and put necessary cleanup in ``finally``\n    blocks or asynchronous context managers.\n    \"\"\"\n    if max_concurrent <= 0:\n        raise ValueError(\"max_concurrent must be greater than zero\")\n\n    pending = iter(tasks)\n\n    async def worker() -> None:\n        # Taking the next job has no await, so workers cannot race here.\n        for job in pending:\n            await job()\n\n    async with asyncio.TaskGroup() as group:\n        for _ in range(min(max_concurrent, len(tasks))):\n            group.create_task(worker())\n"}}],"kind":"artifact","listings":[]},"judgment":{"diagnostic":null,"passed":true}},{"case":1,"check":"cancel-on-interrupt","evidence":{"case_index":1,"challenge_digest":"sha256:4bea1fbae881b654380ef61005b9992d2916608b6cf8d18295f584977e931a5c","check_id":"cancel-on-interrupt","facts":{"duration_seconds":2.836,"ending":"returned","exit_status":0},"kind":"case","outcome":{"observed":{"stdout":["Task started.","Task started.","Cleaned up.","Cleaned up.",""],"timed_out":false}},"output_artifacts":[]},"judgment":{"diagnostic":{"test":"test_tasks_cancel_at_max_concurrent"},"passed":true}},{"case":0,"check":"cancel-on-interrupt","evidence":{"case_index":0,"challenge_digest":"sha256:8ccc548a4450df4bd7b1f1cfc352ef70105