asks(\n    tasks: list[Callable[[], Awaitable[None]]], max_concurrent: int\n) -> None:\n    \"\"\"Run task callables with at most `max_concurrent` running at once.\n\n    If a task raises, or this coroutine is cancelled (e.g. by Ctrl-C under\n    asyncio.run), all running tasks are cancelled and awaited so their cleanup\n    code finishes before the exception propagates.\n    \"\"\"\n    if max_concurrent < 1:\n        raise ValueError(\"max_concurrent must be >= 1\")\n\n    pending = iter(tasks)\n\n    async def worker() -> None:\n        for task in pending:  # shared iterator: each task is taken exactly once\n            await task()\n\n    workers = [\n        asyncio.ensure_future(worker()) for _ in range(min(max_concurrent, len(tasks)))\n    ]\n    try:\n        await asyncio.gather(*workers)\n    finally:\n        for w in workers:\n            if not w.done():\n                w.cancel()\n        # Wait for cancelled tasks to finish their cleanup. If we're cancelled\n        # again while waiting, keep waiting so cleanup is not abandoned.\n        while workers:\n            try:\n                await asyncio.gather(*workers, return_exceptions=True)\n                break\n            except asyncio.CancelledError:\n                continue\n"}}],"kind":"artifact","listings":[]},"judgment":{"diagnostic":null,"passed":true}},{"case":1,"check":"cancel-on-interrupt","evidence":{"case_index":1,"challenge_digest":"sha256:4bea1fbae881b654380ef61005b9992d2916608b6cf8d18295f584977e931a5c","check_id":"cancel-on-interrupt","facts":{"duration_seconds":3.465,"ending":"returned","exit_status":0},"kind":"case","outcome":{"observed":{"stdout":["Task started.","Task started.","Cleaned up.","Cleaned up.",""],"timed_out":false}},"output_artifacts":[]},"judgment":{"diagnostic":{"test":"test_tasks_cancel_at_max_concurrent"},"passed":true}},{"case":0,"check":"cancel-on-interrupt","evidence":{"case_index":0,"challenge_digest":"sha256:8ccc548a4450df4bd7b1f1cfc352ef701058730a5ec5f